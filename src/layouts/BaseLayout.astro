---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "The Kali Hypothesis" } = Astro.props;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "G-PY77PEBT2L";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      gaMeasurementId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script
            is:inline
            define:vars={{ gaMeasurementId }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
