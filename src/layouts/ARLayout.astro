---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title} · The Kali Hypothesis</title>
    <!--
      A-Frame + AR.js — loaded only on this page.
      Pinned versions: 1.4.2 + 3.4.5 is a known-good pairing, confirmed
      working end-to-end (camera + marker tracking) via a live isolation
      test at /ar-test.html. Don't swap either for "latest" independently
      of the other — version drift between the two is a common cause of
      a black screen.
    -->
    <script src="https://aframe.io/releases/1.4.2/aframe.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js@3.4.5/aframe/build/aframe-ar.js" is:inline></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Deliberately NOT setting a background colour here. An opaque
       background on html/body is one of the ways the camera feed gets
       hidden behind the page — this was the site's actual black-screen
       cause, confirmed by comparison against a working isolation test. */
  }

  /* AR.js injects its own <video>. These rules make sure nothing on
     this page competes with it for stacking order. */
  .a-canvas {
    z-index: 1 !important;
  }
  video {
    z-index: 0 !important;
  }
</style>
