---
import MainLayout from './MainLayout.astro';

// TEMPORARY layout: gives a page the main page's look -- the office
// scene behind a dimmed backdrop, with the page's content on a paper
// panel like the hand note. Swap for the real design when it exists.
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<MainLayout title={title}>
  <div class="scene-page">
    <img class="scene-bg" src="/images/office/scene-complete.jpg" alt="" aria-hidden="true" />
    <div class="scene-dim"></div>

    <a class="scene-back" href="/">&larr; Back to the office</a>

    <main class="scene-paper">
      <slot />
    </main>
  </div>
</MainLayout>

<style>
  .scene-page {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0a0a0a;
  }

  .scene-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .scene-dim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .scene-back {
    position: absolute;
    top: 36px;
    left: 48px;
    color: #f5f5f0;
    font-family: 'Komika Hand', 'Courier New', Courier, monospace;
    font-size: 22px;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .scene-back:hover {
    opacity: 0.7;
  }

  .scene-paper {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1040px;
    max-height: 920px;
    overflow: auto;
    padding: 56px 72px;
    transform: translate(-50%, -50%) rotate(-1deg);
    background: #f5f5f0;
    color: #111;
    font-family: 'Komika Hand', 'Courier New', Courier, monospace;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.7);
    scrollbar-width: none;
  }
</style>
