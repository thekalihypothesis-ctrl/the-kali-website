---
interface Props {
  title: string;
}
const { title } = Astro.props;

// Fixed canvas size — matches the source artwork (1920x1080).
// The complete canvas is scaled uniformly to fit each viewport,
// preserving the artwork and hotspot coordinates at every size.
const CANVAS_WIDTH = 1920;
const CANVAS_HEIGHT = 1080;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · The Kali Hypothesis</title>
  </head>
  <body>
    <div class="stage-wrapper">
      <div
        class="stage"
        data-stage
        style={`width:${CANVAS_WIDTH}px;height:${CANVAS_HEIGHT}px;`}
      >
        <slot />
      </div>
    </div>

    <script is:inline define:vars={{ CANVAS_WIDTH, CANVAS_HEIGHT }}>
      const stage = document.querySelector('[data-stage]');

      const fitStageToViewport = () => {
        const scale = Math.min(
          window.innerWidth / CANVAS_WIDTH,
          window.innerHeight / CANVAS_HEIGHT,
        );

        stage.style.setProperty('--stage-scale', String(scale));
        stage.dataset.fitted = 'true';
      };

      fitStageToViewport();
      window.addEventListener('resize', fitStageToViewport, { passive: true });
      window.addEventListener('orientationchange', fitStageToViewport, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0a0a0a;
    --paper: #f5f5f0;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    font-family: 'Courier New', Courier, monospace;
  }

  .stage-wrapper {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--ink);
  }

  .stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(var(--stage-scale, 0));
    transform-origin: center;
    opacity: 0;
  }

  .stage[data-fitted='true'] {
    opacity: 1;
  }

  .stage img.scene-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
