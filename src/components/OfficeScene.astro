---
import ClickableRegion from './ClickableRegion.astro';
import DetectiveNote from './DetectiveNote.astro';
import { hotspots } from '../data/hotspots.js';

// Append ?debug=1 to any URL to see red outlines over every
// hotspot — handy while you're tuning coordinates against your
// real cropped assets.
const debug = Astro.url.searchParams.get('debug') === '1';

// Filing-cabinet drawers: same open/close pictures as the case-file
// pages' cabinet nav (CabinetNav.astro).
const drawerIds = ['about', 'story', 'shows', 'collectibles'];
---
<div class="office-scene">
  <!--
    Using the COMPLETE labeled scene for now (cabinet labels, bookshelf
    labels, "NEXT EVENT" text all baked in) so the site is visually
    functional immediately, with invisible clickable regions on top.

    Once you have your real per-element cropped PNGs, swap this to
    scene-base.jpg (the empty room) and layer each element as its own
    positioned <img> inside its ClickableRegion — that unlocks per-
    element hover states (e.g. a drawer glowing on hover) instead of
    just a highlighted box.
  -->
  <img
    class="scene-bg"
    src="/images/office/scene-complete.jpg"
    alt="The Kali Hypothesis — detective office"
  />

  <!--
    Open-drawer pictures for the filing cabinet, laid over the baked-in
    closed one. nav-<id>.png is the same cabinet art at native size —
    aligned to the scene by image matching (offset 123,312), then
    clipped below the cabinet top so the cat mask sitting on it stays.
    A drawer opens while you hover it, and stays open while its note is
    showing (DetectiveNote sets data-open-drawer on .office-scene).
  -->
  {drawerIds.map((id) => (
    <img
      class={`drawer-frame drawer-frame--${id}`}
      src={`/images/Navbars/nav-${id}.png`}
      alt=""
      aria-hidden="true"
      width="340"
      height="736"
    />
  ))}

  {hotspots.map((spot) => (
    <ClickableRegion
      id={spot.id}
      drawer={drawerIds.includes(spot.id)}
      href={spot.href}
      label={spot.label}
      x={spot.x}
      y={spot.y}
      w={spot.w}
      h={spot.h}
      debug={debug}
      note={spot.note}
    />
  ))}

  <!--
    Pinned to the blank wall right of the bookshelf — there's no baked-in
    label for this in scene-complete.jpg (unlike the other hotspots), so
    it's a real visible element rather than an invisible region over
    existing artwork. First-pass position, eyeballed like hotspots.js.
  -->
  <a class="news-tab" href="/news" aria-label="Memo">
    <span class="news-tab-pin"></span>
    MEMO
  </a>

  <!--
    The bottom desk-drawer label is baked into scene-complete.jpg as
    "KALI" and can't be edited in place, so this real drawer-label
    asset (matching the D1/D2/D3 art style, supplied) sits over it —
    covers both the pull handle and the tag. Purely visual
    (pointer-events: none); clicking still goes through to the
    desk-drawer-d4 ClickableRegion underneath, unaffected. Coordinates
    measured directly against the source image (cropped + zoomed).
  -->
  <img class="drawer-patch" src="/images/office/drawer-d4-label.png" alt="" aria-hidden="true" />

  <!--
    New Kali hotspot: the ghost-cat drawing replaces the drawer as the
    way to reach /kali. First-pass position under the desk, eyeballed
    against the reference mockup — nudge if it doesn't sit right on the
    floor line.
  -->
  <a class="kali-cat" href="/kali" aria-label="Kali">
    <img src="/images/office/kali-cat.png" alt="" />
  </a>

  <!--
    Top-left magnifying-glass logo, baked into scene-complete.jpg and
    scaled down 10% here. Since it can't be edited in place, this
    overlay was generated by cropping the logo's bounding box (95,5,
    370,262), erasing it (rebuilt from a clean tiled sample of the
    background + the vertical wall line that passes behind the logo,
    not a plain fill), and compositing a 90%-scaled copy of the logo
    back on top, centered. Purely visual (pointer-events: none) --
    clicking still goes through to the "logo" ClickableRegion
    underneath, unaffected.
  -->
  <img class="logo-patch" src="/images/office/logo-shrunk.png" alt="" aria-hidden="true" />

  <DetectiveNote />
</div>

<style>
  .office-scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .drawer-frame {
    position: absolute;
    left: 123px;
    top: 312px;
    width: 340px;
    height: 736px;
    display: block;
    clip-path: inset(44px 0 0 0);
    opacity: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .office-scene[data-open-drawer='about'] .drawer-frame--about,
  .office-scene:has(.hotspot[data-hotspot-id='about']:hover) .drawer-frame--about,
  .office-scene:has(.hotspot[data-hotspot-id='about']:focus-visible) .drawer-frame--about,
  .office-scene[data-open-drawer='story'] .drawer-frame--story,
  .office-scene:has(.hotspot[data-hotspot-id='story']:hover) .drawer-frame--story,
  .office-scene:has(.hotspot[data-hotspot-id='story']:focus-visible) .drawer-frame--story,
  .office-scene[data-open-drawer='shows'] .drawer-frame--shows,
  .office-scene:has(.hotspot[data-hotspot-id='shows']:hover) .drawer-frame--shows,
  .office-scene:has(.hotspot[data-hotspot-id='shows']:focus-visible) .drawer-frame--shows,
  .office-scene[data-open-drawer='collectibles'] .drawer-frame--collectibles,
  .office-scene:has(.hotspot[data-hotspot-id='collectibles']:hover) .drawer-frame--collectibles,
  .office-scene:has(.hotspot[data-hotspot-id='collectibles']:focus-visible) .drawer-frame--collectibles {
    opacity: 1;
  }

  .news-tab {
    position: absolute;
    left: 1770px;
    top: 380px;
    width: 110px;
    padding: 14px 10px 10px;
    display: block;
    background: #f5f5f0;
    color: #0a0a0a;
    font-family: 'Komika Hand', 'Courier New', Courier, monospace;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    letter-spacing: 0.02em;
    border: 2px solid #0a0a0a;
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.6);
    transform: rotate(-4deg);
    transition: transform 0.15s ease;
  }

  .news-tab:hover,
  .news-tab:focus-visible {
    transform: rotate(-1deg) scale(1.05);
  }

  .news-tab-pin {
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #7a1f1f;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .drawer-patch {
    position: absolute;
    /* The supplied asset (165x78) was already sized to roughly match
       the drawer's real proportions -- placed near its native size
       (previously shrunk to 84x52, which is why it looked like a small
       floating patch instead of reaching the drawer's actual left/right
       edges at ~1129px/~1305px, measured directly from the artwork). */
    left: 1135px;
    top: 948px;
    width: 165px; /* 176px scaled down 6% -- lands almost exactly on the asset's native 165px width */
    aspect-ratio: 165 / 78;
    display: block;
    pointer-events: none;
  }

  .kali-cat {
    position: absolute;
    left: 655px;
    top: 860px;
    width: 90px;
    height: 162px;
    display: block;
  }

  .kali-cat img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.5));
    transition: transform 0.15s ease;
  }

  .kali-cat:hover img,
  .kali-cat:focus-visible img {
    transform: scale(1.08);
  }

  .logo-patch {
    position: absolute;
    left: 95px;
    top: 5px;
    width: 370px;
    height: 262px;
    display: block;
    pointer-events: none;
  }
</style>
