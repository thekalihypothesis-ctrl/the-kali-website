---
import ClickableRegion from './ClickableRegion.astro';
import DetectiveNote from './DetectiveNote.astro';
import DeskBio from './DeskBio.astro';
import { hotspots } from '../data/hotspots.js';

// Append ?debug=1 to any URL to see red outlines over every
// hotspot — handy while you're tuning coordinates against your
// real cropped assets.
const debug = Astro.url.searchParams.get('debug') === '1';

// Filing-cabinet drawers: same open/close pictures as the case-file
// pages' cabinet nav (CabinetNav.astro).
// Each open-drawer picture is trimmed to the cabinet front and has its own
// size, so each is placed individually: x, y are scene px, found by image
// matching against scene-complete.jpg (0.8+ of pixels agree at that spot,
// less one px either way). Placing them by matching, not at one shared
// corner, is what keeps the cabinet from shifting as drawers open.
const cabinetDrawers = [
  { id: 'about', src: 'nav-about', x: 123, y: 348, w: 252, h: 700 },
  { id: 'story', src: 'nav-story', x: 123, y: 350, w: 250, h: 698 },
  { id: 'shows', src: 'nav-shows-open', x: 121, y: 346, w: 248, h: 702 },
  { id: 'collectibles', src: 'nav-collectibles', x: 121, y: 348, w: 250, h: 700 },
];
const drawerIds = cabinetDrawers.map((d) => d.id);

// Desk drawers: public/images/Desk/<art>-Drawer_Closed.png / _Open.png at
// (x, y) -- found by image matching against the scene -- laid over the
// baked-in drawers. The open picture is a few px bigger (the drawer
// slides toward you). The pictures are 165x78-79 closed; w/h are the open size.
const deskDrawers = [
  { id: 'desk-drawer-d1', art: 'D1', x: 1138, y: 732, w: 167, h: 87 },
  { id: 'desk-drawer-d2', art: 'D2', x: 1138, y: 808, w: 169, h: 88 },
  { id: 'desk-drawer-d3', art: 'D3', x: 1138, y: 883, w: 168, h: 84 },
  { id: 'desk-drawer-d4', art: 'D4', x: 1139, y: 959, w: 174, h: 86 },
];
const deskIds = deskDrawers.map((d) => d.id);
---
<div class="office-scene">
  <!--
    Using the COMPLETE labeled scene for now (cabinet labels, bookshelf
    labels, "NEXT EVENT" text all baked in) so the site is visually
    functional immediately, with invisible clickable regions on top.

    Once you have your real per-element cropped PNGs, swap this to
    scene-base.jpg (the empty room) and layer each element as its own
    positioned <img> inside its ClickableRegion — that unlocks per-
    element hover states (e.g. a drawer glowing on hover) instead of
    just a highlighted box.
  -->
  <img
    class="scene-bg"
    src="/images/office/scene-complete.jpg"
    alt="The Kali Hypothesis — detective office"
  />

  <!--
    Open-drawer pictures for the filing cabinet, laid over the baked-in
    closed one (positions in cabinetDrawers above).
    A drawer opens while you hover it, and stays open while its note is
    showing (DetectiveNote sets data-open-drawer on .office-scene).
    Shows uses nav-shows-open.png.
  -->
  {cabinetDrawers.map((d) => (
    <img
      class={`drawer-frame drawer-frame--${d.id}`}
      src={`/images/Navbars/${d.src}.png`}
      alt=""
      aria-hidden="true"
      width={d.w}
      height={d.h}
      style={`left:${d.x}px; top:${d.y}px; width:${d.w}px; height:${d.h}px;`}
    />
  ))}

  {deskDrawers.map((d) => (
    <img
      class={`desk-drawer ${d.id}`}
      src={`/images/Desk/${d.art}-Drawer_Open.png`}
      alt=""
      aria-hidden="true"
      style={`left:${d.x}px; top:${d.y}px; width:${d.w}px; height:${d.h}px;`}
    />
  ))}

  {hotspots.map((spot) => (
    <ClickableRegion
      id={spot.id}
      drawer={drawerIds.includes(spot.id) || deskIds.includes(spot.id)}
      growX={deskIds.includes(spot.id) ? 0 : undefined}
      growY={deskIds.includes(spot.id) ? 8 : undefined}
      href={spot.href}
      label={spot.label}
      x={spot.x}
      y={spot.y}
      w={spot.w}
      h={spot.h}
      debug={debug}
      note={spot.note}
      bio={spot.bio}
    />
  ))}

  <!--
    Pinned to the blank wall right of the bookshelf — there's no baked-in
    label for this in scene-complete.jpg (unlike the other hotspots), so
    it's a real visible element rather than an invisible region over
    existing artwork. First-pass position, eyeballed like hotspots.js.
  -->
  <a class="news-tab" href="/news" aria-label="Memo">
    <span class="news-tab-pin"></span>
    MEMO
  </a>

  <!-- Closed desk drawers from the Desk art, covering the baked-in ones. -->
  {deskDrawers.map((d) => (
    <img
      class="desk-drawer-closed"
      src={`/images/Desk/${d.art}-Drawer_Closed.png`}
      alt=""
      aria-hidden="true"
      style={`left:${d.x}px; top:${d.y}px;`}
    />
  ))}

  <!--
    New Kali hotspot: the ghost-cat drawing replaces the drawer. Clicking
    it pops up Kali's character card (DeskBio.astro), and the next click
    shows Ghost Kali's. First-pass position under the desk, eyeballed
    against the reference mockup — nudge if it doesn't sit right on the
    floor line.
  -->
  <a
    class="kali-cat hotspot--bio"
    href="/kali"
    aria-label="Kali"
    data-hotspot-id="kali-cat"
    data-bio="/images/Kali-bio.png,/images/Ghost-Kali-bio.png"
  >
    <img src="/images/office/kali-cat.png" alt="" />
  </a>

  <!--
    Top-left magnifying-glass logo, baked into scene-complete.jpg and
    scaled down 10% here. Since it can't be edited in place, this
    overlay was generated by cropping the logo's bounding box (95,5,
    370,262), erasing it (rebuilt from a clean tiled sample of the
    background + the vertical wall line that passes behind the logo,
    not a plain fill), and compositing a 90%-scaled copy of the logo
    back on top, centered. Purely visual (pointer-events: none) --
    clicking still goes through to the "logo" ClickableRegion
    underneath, unaffected.
  -->
  <img class="logo-patch" src="/images/office/logo-shrunk.png" alt="" aria-hidden="true" />

  <DetectiveNote />
  <DeskBio />
</div>

<style>
  .office-scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .drawer-frame {
    position: absolute;
    display: block;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .office-scene[data-open-drawer='about'] .drawer-frame--about,
  .office-scene:has(.hotspot[data-hotspot-id='about']:hover) .drawer-frame--about,
  .office-scene:has(.hotspot[data-hotspot-id='about']:focus-visible) .drawer-frame--about,
  .office-scene[data-open-drawer='story'] .drawer-frame--story,
  .office-scene:has(.hotspot[data-hotspot-id='story']:hover) .drawer-frame--story,
  .office-scene:has(.hotspot[data-hotspot-id='story']:focus-visible) .drawer-frame--story,
  .office-scene[data-open-drawer='shows'] .drawer-frame--shows,
  .office-scene:has(.hotspot[data-hotspot-id='shows']:hover) .drawer-frame--shows,
  .office-scene:has(.hotspot[data-hotspot-id='shows']:focus-visible) .drawer-frame--shows,
  .office-scene[data-open-drawer='collectibles'] .drawer-frame--collectibles,
  .office-scene:has(.hotspot[data-hotspot-id='collectibles']:hover) .drawer-frame--collectibles,
  .office-scene:has(.hotspot[data-hotspot-id='collectibles']:focus-visible) .drawer-frame--collectibles {
    opacity: 1;
  }

  .desk-drawer {
    position: absolute;
    z-index: 1; /* above the closed drawers, which come later in the page */
    display: block;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .office-scene[data-open-desk='desk-drawer-d1'] .desk-drawer-d1,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d1']:hover) .desk-drawer-d1,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d1']:focus-visible) .desk-drawer-d1,
  .office-scene[data-open-desk='desk-drawer-d2'] .desk-drawer-d2,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d2']:hover) .desk-drawer-d2,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d2']:focus-visible) .desk-drawer-d2,
  .office-scene[data-open-desk='desk-drawer-d3'] .desk-drawer-d3,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d3']:hover) .desk-drawer-d3,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d3']:focus-visible) .desk-drawer-d3,
  .office-scene[data-open-desk='desk-drawer-d4'] .desk-drawer-d4,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d4']:hover) .desk-drawer-d4,
  .office-scene:has(.hotspot[data-hotspot-id='desk-drawer-d4']:focus-visible) .desk-drawer-d4 {
    opacity: 1;
  }

  .news-tab {
    position: absolute;
    left: 1770px;
    top: 380px;
    width: 110px;
    padding: 14px 10px 10px;
    display: block;
    background: #f5f5f0;
    color: #0a0a0a;
    font-family: 'Komika Hand', 'Courier New', Courier, monospace;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    letter-spacing: 0.02em;
    border: 2px solid #0a0a0a;
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.6);
    transform: rotate(-4deg);
    transition: transform 0.15s ease;
  }

  .news-tab:hover,
  .news-tab:focus-visible {
    transform: rotate(-1deg) scale(1.05);
  }

  .news-tab-pin {
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #7a1f1f;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .desk-drawer-closed {
    position: absolute;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .kali-cat {
    position: absolute;
    left: 655px;
    top: 860px;
    width: 90px;
    height: 162px;
    display: block;
  }

  .kali-cat img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.5));
    transition: transform 0.15s ease;
  }

  .kali-cat:hover img,
  .kali-cat:focus-visible img {
    transform: scale(1.08);
  }

  .logo-patch {
    position: absolute;
    left: 95px;
    top: 5px;
    width: 370px;
    height: 262px;
    display: block;
    pointer-events: none;
  }
</style>
