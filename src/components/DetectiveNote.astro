---
// Popup shown instead of navigating when a hotspot has a `note` (see
// hotspots.js) — the hand holds up a case note with that hotspot's
// title/body instead of leaving the office scene.
//
// hand-note.png contains BOTH the hand and the paper in one image, so
// the text overlay below is positioned as a percentage of the image's
// own bounds to land on the blank paper area, avoiding the paperclip
// (top-left) and the hand/fingers (bottom-left). Eyeballed from the
// source art, same as hotspots.js — nudge the .note-paper-content
// inset values if the art changes.
---
<div class="detective-note-overlay" data-detective-note aria-hidden="true">
  <div class="detective-note-backdrop" data-note-backdrop></div>

  <div class="detective-note-card">
    <img class="note-hand-img" src="/images/hand-note.png" alt="" />

    <button class="note-close" data-note-close aria-label="Close note" type="button">&times;</button>

    <div class="note-paper-content">
      <div class="note-header">
        <h2 class="note-title" data-note-title></h2>
        <div class="note-stamp">
          <img class="note-mask" src="/images/note-logo.png" alt="" />
          <div class="note-tagline">TRUTH<br />LEAVES<br />CLUES</div>
        </div>
      </div>

      <div class="note-body" data-note-body></div>

      <div class="note-divider"></div>
      <div class="note-footer">
        <div class="note-footer-left">Same Questions.<br />New Perspectives.</div>
        <div class="note-footer-paw" aria-hidden="true">&#128062;</div>
        <div class="note-footer-right">THE KALI<br />HYPOTHESIS</div>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.querySelector('[data-detective-note]');
  const titleEl = overlay?.querySelector('[data-note-title]');
  const bodyEl = overlay?.querySelector('[data-note-body]');

  // The office scene opens the matching cabinet drawer while its note is up.
  const scene = document.querySelector('.office-scene');

  function openNote(title, paragraphs, drawerId) {
    if (!overlay || !titleEl || !bodyEl) return;
    titleEl.textContent = title;
    bodyEl.innerHTML = paragraphs.map((p) => `<p>${p}</p>`).join('');
    // Long titles shrink so they stay beside the cat mask.
    titleEl.style.fontSize = `${Math.min(100, Math.floor(430 / (title.length * 0.62)))}px`;
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    if (scene && drawerId) scene.dataset.openDrawer = drawerId;
    // Shrink the body text from the design size until it fits the paper
    // (longer notes like Story would otherwise scroll).
    let size = 23;
    bodyEl.style.fontSize = `${size}px`;
    while (size > 14 && bodyEl.scrollHeight > bodyEl.clientHeight) {
      size -= 0.5;
      bodyEl.style.fontSize = `${size}px`;
    }
  }

  function closeNote() {
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    if (scene) delete scene.dataset.openDrawer;
  }

  // Any hotspot rendered with a `note` prop gets this class instead of
  // navigating away — see ClickableRegion.astro.
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest('.hotspot--note');
    if (!trigger) return;
    e.preventDefault();
    const title = trigger.getAttribute('data-note-title') || '';
    const body = JSON.parse(trigger.getAttribute('data-note-body') || '[]');
    openNote(title, body, trigger.getAttribute('data-hotspot-id'));
  });

  overlay?.querySelector('[data-note-backdrop]')?.addEventListener('click', closeNote);
  overlay?.querySelector('[data-note-close]')?.addEventListener('click', closeNote);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNote();
  });
</script>

<style>
  .detective-note-overlay {
    position: absolute;
    inset: 0;
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .detective-note-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .detective-note-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .detective-note-card {
    position: absolute;
    /* The hand + paper fill the left 93% of the picture; 22.6% centres them on the stage. */
    left: 22.6%;
    bottom: -4%;
    width: 58.8%;
    aspect-ratio: 2208 / 2312;
    /* Slight tilt so the note reads as tossed/held at an angle rather
       than perfectly upright -- same idea as the office-scene MEMO
       tab's rotation. Text and image are children of this card, so
       they rotate together as one rigid note. */
    transform: translateY(70%) rotate(-5deg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .detective-note-overlay.is-open .detective-note-card {
    transform: translateY(0) rotate(-5deg);
  }

  .note-hand-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .note-close {
    position: absolute;
    top: 6%;
    right: 4%;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.85);
    color: #f5f5f0;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .note-paper-content {
    position: absolute;
    /* Measured against the actual hand-note.png pixels (the paper is
       angled, not a clean rectangle — its right edge sits ~8% in from
       the image edge, and its bottom-right corner recedes sharply
       below ~87% height), not just eyeballed. */
    left: 41%;
    right: 12%;
    top: 19%;
    bottom: 16.5%;
    display: flex;
    flex-direction: column;
    color: #111;
    font-family: 'Komika Hand', 'Courier New', Courier, monospace;
    overflow: hidden;
    /* The paper is drawn ~3deg off the image's own vertical, on top of
       the card's tilt, so the text turns with it to sit along the sheet. */
    transform: rotate(-3deg);
  }

  .note-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .note-header {
    align-items: flex-end;
    margin-left: 6%;
  }

  .note-title {
    margin: 0;
    font-size: 100px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-bottom: 5px solid #111;
    padding-bottom: 6px;
    white-space: nowrap;
  }

  .note-stamp {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    align-self: flex-start;
  }

  .note-mask {
    width: 74px;
    height: auto;
    display: block;
  }

  .note-tagline {
    font-size: 18px;
    line-height: 1.25;
    text-align: right;
    white-space: nowrap;
  }

  .note-body {
    flex: 1;
    overflow: auto;
    margin-top: 22px;
    font-size: 23px;
    line-height: 1.3;
    padding-bottom: 14px;
    scrollbar-width: none;
  }

  .note-body p {
    margin: 0 0 22px;
  }

  /* The hand covers the paper's lower-left, so later paragraphs step in. */
  .note-body p:nth-child(n + 3) {
    margin-left: 15%;
  }

  .note-divider {
    width: 62%;
    margin-left: 6%;
    border-top: 2px solid #111;
  }

  .note-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 0 0 6%;
    font-size: 16px;
    white-space: nowrap;
  }

  .note-footer-left {
        font-size: 24px;
    line-height: 1.2;
  }

  .note-footer-right {
    font-weight: 400;
    text-align: right;
    text-transform: uppercase;
  }

  .note-footer-paw {
    font-size: 30px;
  }
</style>
