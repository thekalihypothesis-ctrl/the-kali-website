---
import { gaMeasurementId } from '../data/site.js';
---
{gaMeasurementId && (
  <script is:inline define:vars={{ gaMeasurementId }}>
    // Google Analytics only loads once the visitor accepts. The choice is
    // remembered in localStorage ('kali-analytics': 'granted' | 'denied');
    // with no choice yet, a banner asks. It is built here, not in the page
    // markup, so every layout that includes <Analytics /> gets it.
    (function () {
      var KEY = 'kali-analytics';

      function read() {
        try { return localStorage.getItem(KEY); } catch (e) { return null; }
      }
      function save(value) {
        try { localStorage.setItem(KEY, value); } catch (e) {}
      }

      function loadAnalytics() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', gaMeasurementId);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
        document.head.appendChild(s);
      }

      function showBanner() {
        var style = document.createElement('style');
        style.textContent =
          '.cookie-banner{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:1000;' +
          'width:min(720px,calc(100vw - 32px));padding:18px 22px;display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;' +
          'background:#f5f5f0;color:#111;border:3px solid #111;box-shadow:0 10px 40px rgba(0,0,0,.6);' +
          "font-family:'Komika Hand','Courier New',Courier,monospace;font-size:16px;line-height:1.4}" +
          '.cookie-banner p{margin:0;flex:1 1 320px}' +
          '.cookie-banner .cookie-actions{display:flex;gap:10px}' +
          '.cookie-banner button{font:inherit;font-size:16px;padding:10px 22px;cursor:pointer;background:#f5f5f0;color:#111;border:2px solid #111}' +
          '.cookie-banner button:hover,.cookie-banner button:focus-visible{background:#111;color:#f5f5f0}';
        document.head.appendChild(style);

        var banner = document.createElement('div');
        banner.className = 'cookie-banner';
        banner.setAttribute('role', 'dialog');
        banner.setAttribute('aria-label', 'Cookie consent');
        banner.innerHTML =
          '<p>We use Google Analytics cookies to see how the site is used. Do you accept them?</p>' +
          '<div class="cookie-actions">' +
          '<button type="button" data-choice="granted">Accept</button>' +
          '<button type="button" data-choice="denied">Decline</button>' +
          '</div>';
        banner.addEventListener('click', function (e) {
          var btn = e.target instanceof Element ? e.target.closest('[data-choice]') : null;
          if (!btn) return;
          var choice = btn.getAttribute('data-choice');
          save(choice);
          banner.remove();
          if (choice === 'granted') loadAnalytics();
        });
        document.body.appendChild(banner);
      }

      var saved = read();
      if (saved === 'granted') {
        loadAnalytics();
      } else if (saved !== 'denied') {
        if (document.body) showBanner();
        else document.addEventListener('DOMContentLoaded', showBanner);
      }
    })();
  </script>
)}
