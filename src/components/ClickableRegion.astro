---
interface Props {
  id?: string;
  drawer?: boolean;
  growX?: number;
  growY?: number;
  href: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  debug?: boolean;
  note?: { title: string; body: string[] };
  bio?: string;
}
const { id, drawer, growX = 22, growY = 25, href, label, x, y, w, h, debug, note, bio } = Astro.props;
---
<a
  class={`hotspot${note ? ' hotspot--note' : ''}${bio ? ' hotspot--bio' : ''}${drawer ? ' hotspot--drawer' : ''}`}
  data-hotspot-id={id}
  href={href}
  aria-label={label}
  style={`--x:${x}px; --y:${y}px; --w:${w}px; --h:${h}px; --grow-x:${growX}px; --grow-y:${growY}px;`}
  data-debug={debug ? 'true' : 'false'}
  data-note-title={note?.title}
  data-note-body={note ? JSON.stringify(note.body) : undefined}
  data-bio={bio}
>
</a>

<style>
  .hotspot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    display: block;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .hotspot:hover,
  .hotspot:focus-visible {
    background-color: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  /* Filing-cabinet drawers show their own opening drawer instead of
     the highlight box (see OfficeScene.astro). */
  .hotspot--drawer:hover {
    background-color: transparent;
    box-shadow: none;
  }

  /* The open drawer slides out past the closed face (--grow-x left,
     --grow-y below; 22/25px for the cabinet). While one is hovered its box grows to cover that, and sits
     above its neighbours, so the pointer on the open drawer keeps it
     open instead of handing over to the drawer underneath. Growing only
     outward means the box never shrinks out from under the pointer. */
  .hotspot--drawer:hover {
    z-index: 2;
    left: calc(var(--x) - var(--grow-x));
    width: calc(var(--w) + var(--grow-x));
    height: calc(var(--h) + var(--grow-y));
  }

  /* Turn on with ?debug=1 — see OfficeScene.astro */
  .hotspot[data-debug='true'] {
    background-color: rgba(255, 0, 0, 0.15);
    box-shadow: inset 0 0 0 1px rgba(255, 0, 0, 0.7);
  }
</style>
