---
import MainLayout from '../layouts/MainLayout.astro';
import { hotspots } from '../data/hotspots.js';

// Same content as the office popup (see hotspots.js) — kept in sync
// rather than carrying its own copy, since direct /about links and the
// cat-mask hotspot (no note popup) land on this page.
const { note } = hotspots.find((spot) => spot.id === 'about');
---
<MainLayout title={note.title}>
  <div class="case-file">
    <a class="back-link" href="/">&larr; Back to the office</a>
    <h1>{note.title}</h1>
    {note.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</MainLayout>

<style>
  .case-file {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 80px 120px;
    background: #0a0a0a;
    color: #f5f5f0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: #f5f5f0;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  h1 {
    font-size: 48px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 24px;
  }

  p {
    max-width: 800px;
    font-size: 18px;
    line-height: 1.6;
  }
</style>
