---
import { collectibles } from '../../data/collectibles.js';
import '../../styles/komika-font.css';
export function getStaticPaths() { return collectibles.map(item => ({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{item.name} &middot; The Kali Hypothesis</title></head>
<body><main><a href="/collectibles">&larr; All collectibles</a><div class="product"><img src={item.image} alt={item.name} /><section><h1>{item.name}</h1><p>{item.description}</p><p>Every collectible is a numbered limited edition and comes with a certificate of authentication.</p><a href="/">Back to the office</a></section></div></main></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f5f5f0;color:#111;font-family:'Komika Hand','Courier New',monospace}main{max-width:1100px;margin:auto;padding:48px 24px}a{color:inherit}h1{text-transform:uppercase;font-size:clamp(28px,4vw,48px)}p{font-size:20px;line-height:1.6}.product{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:64px;margin-top:48px}.product img{width:100%;max-height:70vh;object-fit:contain;mix-blend-mode:multiply}@media(max-width:650px){.product{grid-template-columns:1fr;gap:24px}.product img{max-height:45vh}}
</style>
