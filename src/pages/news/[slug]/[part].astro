---
import NodeLayout from '../../../layouts/NodeLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { articles } from '../../../data/articles.js';

export function getStaticPaths() {
  const paths = [];
  for (const article of articles) {
    if (!article.sections) continue;
    article.sections.forEach((section, index) => {
      paths.push({
        params: { slug: article.slug, part: section.slug },
        props: {
          article,
          section,
          prev: article.sections[index - 1] ?? null,
          next: article.sections[index + 1] ?? null,
        },
      });
    });
  }
  return paths;
}

const { article, section, prev, next } = Astro.props;
const crumbs = [
  { label: 'Memo', href: '/news' },
  { label: article.title, href: `/news/${article.slug}` },
  { label: section.heading },
];
---
<NodeLayout title={`${section.heading} · ${article.title}`}>
  <div class="feed">
    <Breadcrumbs crumbs={crumbs} />

    <h1>{section.heading}</h1>

    <div class="glossary-grid" data-glossary-grid>
      {section.terms.map((entry) => (
        <button
          class="glossary-term"
          type="button"
          data-term={entry.term}
          data-tagline={entry.tagline}
          data-definition={entry.definition}
        >
          <p class="term-name">{entry.term}</p>
          <p class="term-tagline">{entry.tagline}</p>
          <p class="term-definition">{entry.definition}</p>
        </button>
      ))}
    </div>

    {section.note && <p class="glossary-note">{section.note}</p>}

    <div class="part-nav">
      {prev ? (
        <a class="nav-link nav-prev" href={`/news/${article.slug}/${prev.slug}`}>&larr; {prev.heading}</a>
      ) : <span />}
      {next ? (
        <a class="nav-link nav-next" href={`/news/${article.slug}/${next.slug}`}>{next.heading} &rarr;</a>
      ) : <span />}
    </div>
  </div>

  <div class="term-modal-overlay" data-term-modal aria-hidden="true">
    <div class="term-modal-backdrop" data-term-modal-backdrop></div>
    <div class="term-modal-card">
      <button class="term-modal-close" data-term-modal-close aria-label="Close" type="button">&times;</button>
      <p class="term-modal-name" data-modal-name></p>
      <p class="term-modal-tagline" data-modal-tagline></p>
      <p class="term-modal-definition" data-modal-definition></p>
    </div>
  </div>
</NodeLayout>

<script>
  const grid = document.querySelector('[data-glossary-grid]');
  const modal = document.querySelector('[data-term-modal]');
  const modalName = modal?.querySelector('[data-modal-name]');
  const modalTagline = modal?.querySelector('[data-modal-tagline]');
  const modalDefinition = modal?.querySelector('[data-modal-definition]');

  function openModal(card) {
    if (!modal || !modalName || !modalTagline || !modalDefinition) return;
    modalName.textContent = card.getAttribute('data-term') || '';
    modalTagline.textContent = card.getAttribute('data-tagline') || '';
    modalDefinition.textContent = card.getAttribute('data-definition') || '';
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeModal() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('aria-hidden', 'true');
  }

  grid?.addEventListener('click', (e) => {
    const card = e.target.closest('.glossary-term');
    if (card) openModal(card);
  });

  modal?.querySelector('[data-term-modal-backdrop]')?.addEventListener('click', closeModal);
  modal?.querySelector('[data-term-modal-close]')?.addEventListener('click', closeModal);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  .feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  h1 {
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 32px;
    color: #4dfaff;
    text-shadow: 0 0 10px rgba(77, 250, 255, 0.3);
  }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .glossary-term {
    display: block;
    width: 100%;
    padding: 14px 16px;
    background: rgba(77, 250, 255, 0.02);
    border: 1px dashed rgba(77, 250, 255, 0.3);
    border-radius: 4px;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .glossary-term:hover,
  .glossary-term:focus-visible {
    background: rgba(77, 250, 255, 0.08);
    border-color: rgba(77, 250, 255, 0.7);
  }

  .term-name {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #eaeaea;
  }

  .term-tagline {
    margin: 2px 0 8px;
    font-size: 12px;
    font-style: italic;
    color: #4dff8f;
    opacity: 0.8;
  }

  .term-definition {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #bbb;
  }

  .glossary-note {
    margin: 24px 0 0;
    font-size: 13px;
    font-style: italic;
    color: #777;
  }

  .part-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px dashed rgba(77, 250, 255, 0.25);
  }

  .nav-link {
    max-width: 45%;
    font-size: 14px;
    color: #4dfaff;
    text-decoration: none;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  .nav-next {
    text-align: right;
    margin-left: auto;
  }

  .term-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .term-modal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .term-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .term-modal-card {
    position: relative;
    max-width: 560px;
    width: 100%;
    padding: 40px;
    background: #0a0a0d;
    border: 1px solid rgba(77, 250, 255, 0.5);
    border-radius: 6px;
    box-shadow: 0 0 50px rgba(77, 250, 255, 0.15);
    opacity: 0;
    transform: scale(0.75) translateY(16px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .term-modal-overlay.is-open .term-modal-card {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .term-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(77, 250, 255, 0.4);
    background: transparent;
    color: #4dfaff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .term-modal-name {
    margin: 0 0 8px;
    font-size: 26px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #eaeaea;
  }

  .term-modal-tagline {
    margin: 0 0 20px;
    font-size: 14px;
    font-style: italic;
    color: #4dff8f;
  }

  .term-modal-definition {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: #ddd;
  }
</style>
