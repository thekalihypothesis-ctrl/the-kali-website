---
import NodeLayout from '../../layouts/NodeLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articles } from '../../data/articles.js';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const crumbs = [
  { label: 'Memo', href: '/news' },
  { label: article.title },
];
---
<NodeLayout title={article.title}>
  <div class="feed">
    <Breadcrumbs crumbs={crumbs} />

    <article class="entry">
      <p class="entry-tag">{article.tag}</p>
      <h1>{article.title}</h1>
      {article.dateline && <p class="entry-dateline">{article.dateline}</p>}

      {article.intro?.map((paragraph) => <p>{paragraph}</p>)}
      {article.body?.map((paragraph) => <p>{paragraph}</p>)}

      {article.sections && (
        <div class="part-grid">
          {article.sections.map((section) => (
            <a class="part-card" href={`/news/${article.slug}/${section.slug}`}>
              <h2>{section.heading}</h2>
              <p class="part-count">{section.terms.length} terms</p>
              <p class="part-open">Open sheet &rarr;</p>
            </a>
          ))}
        </div>
      )}
    </article>
  </div>
</NodeLayout>

<style>
  .feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  .entry-tag {
    margin: 0 0 8px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4dff8f;
    text-shadow: 0 0 6px rgba(77, 255, 143, 0.35);
  }

  h1 {
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 16px;
    max-width: 800px;
    color: #eaeaea;
    text-shadow: 0 0 10px rgba(77, 250, 255, 0.25);
  }

  .entry-dateline {
    margin: -8px 0 16px;
    font-size: 13px;
    color: #777;
  }

  .entry p {
    max-width: 800px;
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: #ccc;
  }

  .part-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .part-card {
    display: block;
    padding: 20px;
    background: rgba(77, 250, 255, 0.03);
    border: 1px dashed rgba(77, 250, 255, 0.3);
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .part-card:hover {
    background: rgba(77, 250, 255, 0.08);
    border-color: rgba(77, 250, 255, 0.7);
  }

  .part-card h2 {
    margin: 0 0 8px;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #eaeaea;
    text-shadow: none;
  }

  .part-count {
    margin: 0 0 12px;
    font-size: 12px;
    color: #666;
  }

  .part-open {
    margin: 0;
    font-size: 13px;
    color: #4dfaff;
  }
</style>
