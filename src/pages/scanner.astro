---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>Marker AR | The Kali Hypothesis</title>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/aframe/1.4.2/aframe.min.js"></script>
    <script is:inline src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>
  </head>
  <body>
    <div id="landing">
      <p class="eyebrow">Web AR / Marker-based</p>
      <h1>POINT &amp;<br /><span>DISCOVER</span></h1>
      <p class="tagline">Print or display your custom marker,<br />then aim your camera at it.</p>

      <div class="marker-card">
        <svg width="110" height="110" viewBox="0 0 110 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="110" height="110" fill="white"></rect>
          <rect x="5" y="5" width="100" height="100" fill="black"></rect>
          <rect x="15" y="15" width="80" height="80" fill="white"></rect>
          <rect x="25" y="25" width="60" height="60" fill="black"></rect>
          <rect x="35" y="35" width="40" height="40" fill="white"></rect>
          <rect x="45" y="45" width="20" height="20" fill="black"></rect>
        </svg>
      </div>

      <p class="marker-hint">Your custom marker - print and display this</p>
      <button class="btn-start" id="btn-start" type="button">Launch Camera</button>
      <p class="note">Camera permission required / Works in Chrome and Safari</p>
    </div>

    <template id="ar-scene-template">
      <a-scene
        id="main-scene"
        embedded
        arjs="sourceType: webcam; debugUIEnabled: false; detectionMode: mono_and_matrix; matrixCodeType: 3x3;"
        vr-mode-ui="enabled: false"
        renderer="alpha: true; logarithmicDepthBuffer: true; antialias: true;"
        loading-screen="enabled: false"
      >
        <a-assets>
          <a-asset-item id="cover-model" src="/ar/cover.glb"></a-asset-item>
        </a-assets>

        <a-marker
          id="custom-marker"
          type="pattern"
          url="/ar/pattern.patt"
          smooth="true"
          smoothCount="10"
          smoothTolerance="0.01"
          smoothThreshold="5"
        >
          <a-entity
            gltf-model="#cover-model"
            position="0 0 0"
            scale="0.5 0.5 0.5"
            rotation="-90 0 0"
            animation="property: rotation; from: -90 0 0; to: -90 360 0; loop: true; dur: 6000; easing: linear"
          ></a-entity>
          <a-light type="ambient" intensity="0.8"></a-light>
          <a-light type="directional" position="1 2 1" intensity="1.2"></a-light>
        </a-marker>

        <a-entity camera></a-entity>
      </a-scene>
    </template>

    <div id="ar-scene-wrapper">
    </div>

    <div id="hud">
      <div class="hud-row">
        <span class="hud-label">Tracking</span>
        <span class="hud-status"><span id="status-dot"></span><span id="status-text">Searching...</span></span>
      </div>
    </div>

    <div id="scan-ring">
      <div class="ring">
        <span class="ring-label">Aim at your marker</span>
      </div>
    </div>

    <button id="btn-close" type="button" aria-label="Close AR">x</button>

    <script is:inline>
      const landing = document.getElementById("landing");
      const sceneWrap = document.getElementById("ar-scene-wrapper");
      const hud = document.getElementById("hud");
      const scanRing = document.getElementById("scan-ring");
      const btnClose = document.getElementById("btn-close");
      const statusText = document.getElementById("status-text");
      const statusDot = document.getElementById("status-dot");
      const btnStart = document.getElementById("btn-start");
      const sceneTemplate = document.getElementById("ar-scene-template");

      const showCameraStatus = (message) => {
        let debug = document.querySelector("#camera-debug");

        if (!debug) {
          debug = document.createElement("div");
          debug.id = "camera-debug";
          debug.style.cssText = `
            position: fixed;
            top: max(10px, env(safe-area-inset-top));
            left: 10px;
            right: 10px;
            padding: 10px;
            background: rgba(0, 0, 0, 0.88);
            color: #ff533d;
            font: 12px monospace;
            z-index: 99999;
            pointer-events: none;
          `;
          document.body.appendChild(debug);
        }

        debug.textContent = message;
      };

      const forceCameraLayer = () => {
        const video = document.querySelector("#arjs-video");
        if (!(video instanceof HTMLVideoElement)) return;

        video.style.setProperty("display", "block", "important");
        video.style.setProperty("visibility", "visible", "important");
        video.style.setProperty("opacity", "1", "important");
        video.style.setProperty("position", "fixed", "important");
        video.style.setProperty("inset", "0", "important");
        video.style.setProperty("width", "100vw", "important");
        video.style.setProperty("height", "100dvh", "important");
        video.style.setProperty("object-fit", "cover", "important");
        video.style.setProperty("z-index", "0", "important");
        video.play().catch((error) => {
          console.error("VIDEO PLAY ERROR", error);
        });
      };

      window.addEventListener("camera-init", (event) => {
        console.log("CAMERA INIT OK", event);
        showCameraStatus("CAMERA STREAM OK");
        forceCameraLayer();
      });

      window.addEventListener("camera-error", (event) => {
        console.error("CAMERA ERROR", event);
        const error = event.error || {};
        showCameraStatus(`CAMERA ERROR: ${error.name || ""} ${error.message || ""}`);
      });

      window.addEventListener("arjs-video-loaded", () => {
        console.log("ARJS VIDEO ELEMENT LOADED");
        forceCameraLayer();

        const video = document.querySelector("#arjs-video");
        if (video instanceof HTMLVideoElement) {
          const styles = getComputedStyle(video);
          console.log("VIDEO:", {
            width: video.videoWidth,
            height: video.videoHeight,
            paused: video.paused,
            readyState: video.readyState,
            display: styles.display,
            visibility: styles.visibility,
            opacity: styles.opacity,
            zIndex: styles.zIndex
          });
        }
      });

      const bindMarkerEvents = () => {
        setTimeout(() => {
          const marker = document.getElementById("custom-marker");
          if (!marker) return;

          marker.addEventListener("markerFound", () => {
            if (!statusText || !statusDot || !scanRing) return;
            statusText.textContent = "Marker detected";
            statusDot.style.background = "#22c55e";
            scanRing.style.display = "none";
          });

          marker.addEventListener("markerLost", () => {
            if (!statusText || !statusDot || !scanRing) return;
            statusText.textContent = "Searching...";
            statusDot.style.background = "#e8431c";
            scanRing.style.display = "block";
          });
        }, 1200);
      };

      btnStart?.addEventListener("click", () => {
        if (!landing || !sceneWrap || !hud || !scanRing || !btnClose) return;
        if (!window["AFRAME"]) {
          if (statusText && statusDot) {
            statusText.textContent = "AR library failed to load";
            statusDot.style.background = "#e8431c";
          }
          hud.style.display = "block";
          return;
        }

        landing.style.display = "none";
        sceneWrap.style.display = "block";
        hud.style.display = "block";
        scanRing.style.display = "block";
        btnClose.style.display = "flex";

        if (sceneTemplate instanceof HTMLTemplateElement && !sceneWrap.querySelector("a-scene")) {
          sceneWrap.appendChild(sceneTemplate.content.cloneNode(true));
          bindMarkerEvents();
          setTimeout(forceCameraLayer, 500);
          setTimeout(forceCameraLayer, 1200);
          setTimeout(forceCameraLayer, 2200);
        }
      });

      btnClose?.addEventListener("click", () => location.reload());
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --ink: #0d0d0d;
    --paper: #f8f5ef;
    --accent: #e8431c;
    --muted: #888;
    --mono: "Courier New", Courier, monospace;
  }

  html,
  body {
    width: 100%;
    min-width: 320px;
    height: 100%;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    font-family: system-ui, sans-serif;
    overscroll-behavior: none;
    touch-action: manipulation;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100dvh;
  }

  button {
    font: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  #landing {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: max(2rem, env(safe-area-inset-top)) max(1.4rem, env(safe-area-inset-right))
      max(2rem, env(safe-area-inset-bottom)) max(1.4rem, env(safe-area-inset-left));
    background: var(--ink);
  }

  .eyebrow {
    margin-bottom: 1.2rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 15vw, 5.5rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
    text-align: center;
  }

  h1 span {
    color: var(--accent);
  }

  .tagline {
    max-width: 340px;
    margin-top: 1.4rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.7;
    text-align: center;
  }

  .marker-card {
    display: flex;
    width: min(140px, 38vw);
    height: min(140px, 38vw);
    align-items: center;
    justify-content: center;
    margin: 2.4rem 0 1rem;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    background: white;
  }

  .marker-card svg {
    display: block;
    width: min(110px, 30vw);
    height: min(110px, 30vw);
  }

  .marker-hint {
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .btn-start {
    min-width: min(280px, 78vw);
    min-height: 52px;
    border: 0;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.85rem 2.8rem;
    text-transform: uppercase;
    transition: opacity 0.18s;
  }

  .btn-start:hover {
    opacity: 0.85;
  }

  .note {
    margin-top: 1.2rem;
    color: #555;
    font-family: var(--mono);
    font-size: 0.6rem;
    text-align: center;
  }

  #ar-scene-wrapper {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    background: transparent;
  }

  a-scene {
    width: 100vw;
    height: 100dvh;
  }

  #arjs-video {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    object-fit: cover !important;
    z-index: 0 !important;
  }

  video {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    object-fit: cover !important;
    z-index: 0 !important;
  }

  canvas.a-canvas,
  .a-canvas {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    background: transparent !important;
    z-index: 1 !important;
  }

  a-scene {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    background: transparent !important;
    z-index: 1 !important;
  }

  #hud {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 20;
    display: none;
    padding: 1rem 1.4rem max(1.6rem, env(safe-area-inset-bottom));
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, transparent 100%);
    pointer-events: none;
  }

  .hud-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hud-label {
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hud-status {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  #status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    animation: pulse 1.6s ease-in-out infinite;
    background: var(--accent);
  }

  #btn-close {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    z-index: 30;
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    cursor: pointer;
    font-size: 1.1rem;
  }

  #scan-ring {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 20;
    display: none;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .ring {
    position: relative;
    width: min(180px, 48vw);
    height: min(180px, 48vw);
    border: 2px solid rgba(232, 67, 28, 0.5);
    border-radius: 6px;
  }

  .ring::before,
  .ring::after {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--accent);
    border-style: solid;
    content: "";
  }

  .ring::before {
    top: -2px;
    left: -2px;
    border-width: 2px 0 0 2px;
  }

  .ring::after {
    right: -2px;
    bottom: -2px;
    border-width: 0 2px 2px 0;
  }

  .ring-label {
    position: absolute;
    bottom: -28px;
    left: 50%;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  @media (orientation: landscape) and (max-height: 520px) {
    #landing {
      justify-content: flex-start;
      overflow: auto;
      padding-top: max(1rem, env(safe-area-inset-top));
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }

    .marker-card {
      margin-top: 1rem;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.25;
    }
  }
</style>
