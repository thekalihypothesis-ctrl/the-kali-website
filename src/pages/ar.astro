---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AR Scanner | The Kali Hypothesis">
  <main class="ar-shell">
    <section id="landing" class="landing" aria-label="AR launch screen">
      <div class="case-folder">
        <header class="case-header">
          <p class="eyebrow">Evidence Terminal</p>
          <p class="case-number">Case 04 / AR</p>
        </header>

        <div class="case-body">
          <section>
            <p class="stamp">The Kali Hypothesis</p>
            <h1>Marker<br /><span>Investigation</span></h1>
            <p class="tagline">
              The archived object is locked to a printed marker. Open the camera and recover the evidence.
            </p>
          </section>

          <aside class="marker-card" aria-label="Marker preview">
            <div class="marker-frame">
              <svg width="132" height="132" viewBox="0 0 132 132" xmlns="http://www.w3.org/2000/svg">
                <rect width="132" height="132" fill="#f8f5ef"></rect>
                <rect x="8" y="8" width="116" height="116" fill="#050505"></rect>
                <rect x="22" y="22" width="88" height="88" fill="#f8f5ef"></rect>
                <rect x="36" y="36" width="60" height="60" fill="#050505"></rect>
                <rect x="49" y="49" width="34" height="34" fill="#f8f5ef"></rect>
                <rect x="59" y="59" width="14" height="14" fill="#050505"></rect>
              </svg>
            </div>
            <p class="marker-hint">Pattern Evidence</p>
          </aside>
        </div>

        <footer class="case-actions">
          <button class="btn-start" id="btn-start" type="button">Open Scanner</button>
          <a class="office-link" href="/">Return to Office</a>
        </footer>
      </div>
    </section>

    <template id="ar-scene-template">
      <a-scene
        id="main-scene"
        embedded
        arjs="sourceType: webcam; sourceWidth: 1280; sourceHeight: 720; displayWidth: 1280; displayHeight: 720; debugUIEnabled: false; detectionMode: mono_and_matrix; matrixCodeType: 3x3;"
        vr-mode-ui="enabled: false"
        renderer="alpha: true; logarithmicDepthBuffer: true; antialias: true; colorManagement: true; physicallyCorrectLights: false; exposure: 1;"
        loading-screen="enabled: false"
      >
        <a-assets>
          <a-asset-item id="cover-model" src="/ar/cover.glb"></a-asset-item>
        </a-assets>

        <a-marker
          id="custom-marker"
          type="pattern"
          url="/ar/pattern.patt"
          smooth="true"
          smoothCount="10"
          smoothTolerance="0.01"
          smoothThreshold="5"
        >
          <a-entity
            id="cover-entity"
            gltf-model="#cover-model"
            position="0 0 0"
            scale="20 20 20"
            rotation="-90 90 0"
            drag-rotate
          ></a-entity>
          <a-light type="ambient" intensity="0.6"></a-light>
          <a-light type="directional" position="1 2 1" intensity="0.8"></a-light>
        </a-marker>

        <a-entity camera></a-entity>
      </a-scene>
    </template>

    <div id="ar-stage" class="ar-stage" aria-label="AR scanner viewport"></div>

    <div id="hud" class="hud">
      <div class="hud-row">
        <span class="hud-label">Evidence lock</span>
        <span class="hud-status"><span id="status-dot"></span><span id="status-text">Searching...</span></span>
      </div>
      <p>Drag to inspect the recovered object</p>
    </div>

    <div id="scan-ring" class="scan-ring">
      <div class="ring">
        <span class="ring-label">Seeking marker</span>
      </div>
    </div>

    <button id="btn-close" class="btn-close" type="button" aria-label="Close AR">x</button>
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const landing = document.getElementById("landing");
      const stage = document.getElementById("ar-stage");
      const hud = document.getElementById("hud");
      const scanRing = document.getElementById("scan-ring");
      const btnClose = document.getElementById("btn-close");
      const statusText = document.getElementById("status-text");
      const statusDot = document.getElementById("status-dot");
      const btnStart = document.getElementById("btn-start");
      const template = document.getElementById("ar-scene-template");
      let dragRotateRegistered = false;
      let scannerOpening = false;

      const loadScriptOnce = (id, src) =>
        new Promise((resolve, reject) => {
          const existing = document.getElementById(id);
          if (existing) {
            existing.addEventListener("load", resolve, { once: true });
            existing.addEventListener("error", reject, { once: true });
            if (existing.dataset.loaded === "true") resolve();
            return;
          }

          const script = document.createElement("script");
          script.id = id;
          script.src = src;
          script.async = false;
          script.onload = () => {
            script.dataset.loaded = "true";
            resolve();
          };
          script.onerror = reject;
          document.head.appendChild(script);
        });

      const loadArLibraries = async () => {
        if (!window["AFRAME"]) {
          await loadScriptOnce("aframe-lib", "https://cdnjs.cloudflare.com/ajax/libs/aframe/1.4.2/aframe.min.js");
        }

        await loadScriptOnce("arjs-lib", "https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js");
      };

      const registerDragRotate = () => {
        const aframe = window["AFRAME"];
        if (!aframe || dragRotateRegistered || aframe.components["drag-rotate"]) return Boolean(aframe);

        aframe.registerComponent("drag-rotate", {
          init: function () {
            this.dragging = false;
            this.lastX = 0;
            this.lastY = 0;
            this.rotY = 0;
            this.rotX = -90;

            const bindCanvas = () => {
              const canvasEl = this.el.sceneEl.canvas;
              if (!canvasEl) return;

              const onDown = (event) => {
                this.dragging = true;
                const point = event.touches ? event.touches[0] : event;
                this.lastX = point.clientX;
                this.lastY = point.clientY;
              };

              const onMove = (event) => {
                if (!this.dragging) return;
                const point = event.touches ? event.touches[0] : event;
                const dx = point.clientX - this.lastX;
                const dy = point.clientY - this.lastY;
                this.lastX = point.clientX;
                this.lastY = point.clientY;
                this.rotY += dx * 0.5;
                this.rotX += dy * 0.5;
                this.el.setAttribute("rotation", `${this.rotX} ${this.rotY} 0`);
              };

              const onUp = () => {
                this.dragging = false;
              };

              canvasEl.addEventListener("mousedown", onDown);
              canvasEl.addEventListener("mousemove", onMove);
              canvasEl.addEventListener("mouseup", onUp);
              canvasEl.addEventListener("mouseleave", onUp);
              canvasEl.addEventListener("touchstart", onDown, { passive: true });
              canvasEl.addEventListener("touchmove", onMove, { passive: true });
              canvasEl.addEventListener("touchend", onUp);
            };

            if (this.el.sceneEl.canvas) {
              bindCanvas();
            } else {
              this.el.sceneEl.addEventListener("render-target-loaded", bindCanvas, { once: true });
            }
          }
        });

        dragRotateRegistered = true;
        return true;
      };

      const bindMarkerEvents = () => {
        const marker = document.getElementById("custom-marker");
        marker?.addEventListener("markerFound", () => {
          statusText.textContent = "Evidence recovered";
          statusDot.style.background = "#22c55e";
          scanRing.style.display = "none";
        });

        marker?.addEventListener("markerLost", () => {
          statusText.textContent = "Searching...";
          statusDot.style.background = "#e8431c";
          scanRing.style.display = "block";
        });
      };

      const constrainRuntimeLayers = () => {
        document.querySelectorAll("body > video").forEach((video) => {
          stage.prepend(video);
        });
      };

      btnStart?.addEventListener("click", async () => {
        if (scannerOpening) return;
        scannerOpening = true;
        btnStart.disabled = true;
        statusText.textContent = "Loading scanner...";
        statusDot.style.background = "#f05a32";
        hud.style.display = "block";

        try {
          await loadArLibraries();
        } catch {
          statusText.textContent = "AR library failed to load";
          statusDot.style.background = "#e8431c";
          scannerOpening = false;
          btnStart.disabled = false;
          return;
        }

        if (!registerDragRotate()) {
          statusText.textContent = "A-Frame failed to start";
          statusDot.style.background = "#e8431c";
          scannerOpening = false;
          btnStart.disabled = false;
          return;
        }

        statusText.textContent = "Searching...";
        document.body.classList.add("ar-active");
        landing.hidden = true;
        stage.classList.add("is-active");

        if (template && !stage.querySelector("a-scene")) {
          stage.appendChild(template.content.cloneNode(true));
          bindMarkerEvents();
        }

        hud.style.display = "block";
        scanRing.style.display = "block";
        btnClose.style.display = "flex";

        window.setTimeout(constrainRuntimeLayers, 250);
        window.setTimeout(constrainRuntimeLayers, 1000);
      });

      btnClose?.addEventListener("click", () => {
        window.location.href = "/";
      });
    });
  </script>
</BaseLayout>

<style>
  .ar-shell {
    --stage-width: min(100vw, calc(100vh * 1.777778));
    --stage-height: min(100vh, calc(100vw / 1.777778));
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.88)),
      url("/images/detective-office-layout.jpg") center / cover;
    color: #f8f5ef;
  }

  .landing {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(18px, 4vw, 44px);
    background:
      linear-gradient(rgba(5, 5, 5, 0.64), rgba(5, 5, 5, 0.82)),
      url("/images/detective-office-layout.jpg") center / cover;
  }

  .case-folder {
    width: min(980px, 100%);
    max-height: calc(100vh - 36px);
    overflow: auto;
    border: 2px solid #f8f5ef;
    background: #f8f5ef;
    box-shadow: 12px 12px 0 #050505;
    color: #050505;
  }

  .case-header,
  .case-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(14px, 2.2vw, 22px);
    border-bottom: 2px solid #050505;
  }

  .case-actions {
    border-top: 2px solid #050505;
    border-bottom: 0;
  }

  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    gap: clamp(18px, 4vw, 54px);
    align-items: center;
    padding: clamp(22px, 5vw, 58px);
  }

  .eyebrow,
  .case-number,
  .stamp,
  .marker-hint,
  .hud-label,
  .hud-status,
  .hud p {
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .eyebrow,
  .case-number,
  .stamp {
    margin: 0;
    font-size: clamp(0.62rem, 1.4vw, 0.86rem);
  }

  .case-number,
  .stamp,
  h1 span {
    color: #b72d18;
  }

  .stamp {
    display: inline-block;
    margin-bottom: 16px;
    border: 2px solid currentColor;
    padding: 8px 10px 6px;
    transform: rotate(-2deg);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 5.7rem);
    font-weight: 900;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .tagline {
    max-width: 28rem;
    margin: 1.4rem 0 0;
    color: #26211e;
    font-size: clamp(0.82rem, 1.6vw, 1.05rem);
    line-height: 1.5;
  }

  .marker-card {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
    padding: 18px;
    background: #050505;
    color: #f8f5ef;
  }

  .marker-frame {
    display: grid;
    width: min(188px, 100%);
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid #f8f5ef;
    background: #f8f5ef;
  }

  .marker-hint {
    margin: 0;
    font-size: 0.68rem;
  }

  .btn-start,
  .office-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 2px solid #050505;
    border-radius: 0;
    background: #050505;
    color: #f8f5ef;
    cursor: pointer;
    font: inherit;
    font-size: clamp(0.72rem, 1.4vw, 0.95rem);
    font-weight: 700;
    padding: 0.78rem 1.2rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .office-link {
    color: #050505;
    background: transparent;
  }

  .btn-start:hover,
  .office-link:hover {
    background: #b72d18;
    color: #f8f5ef;
  }

  .ar-stage {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: none;
    width: var(--stage-width);
    height: var(--stage-height);
    margin: auto;
    overflow: hidden;
    background: #050505;
  }

  .ar-stage.is-active {
    display: block;
  }

  .ar-stage :global(a-scene),
  .ar-stage :global(video),
  .ar-stage :global(canvas.a-canvas),
  .ar-stage :global(.a-canvas) {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .ar-stage :global(video) {
    object-fit: contain !important;
  }

  .ar-stage :global(a-scene),
  .ar-stage :global(canvas.a-canvas),
  .ar-stage :global(.a-canvas) {
    background: transparent !important;
  }

  .hud {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    display: none;
    width: var(--stage-width);
    margin: 0 auto;
    padding: 1rem 1.4rem 1.5rem;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.86) 0%, rgba(5, 5, 5, 0.18) 100%);
    pointer-events: none;
  }

  .hud-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hud-label,
  .hud-status,
  .hud p {
    font-size: 0.68rem;
  }

  .hud-label,
  .hud p {
    color: rgba(255, 255, 255, 0.5);
  }

  .hud-status {
    color: #f05a32;
  }

  .hud p {
    margin: 0.6rem 0 0;
    text-align: center;
  }

  #status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    animation: pulse 1.6s ease-in-out infinite;
    background: #f05a32;
  }

  .btn-close {
    position: fixed;
    top: calc((100vh - var(--stage-height)) / 2 + 1rem);
    right: calc((100vw - var(--stage-width)) / 2 + 1rem);
    z-index: 60;
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .scan-ring {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 40;
    display: none;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .ring {
    position: relative;
    width: 180px;
    height: 180px;
    border: 2px solid rgba(240, 90, 50, 0.64);
  }

  .ring::before,
  .ring::after {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: #f05a32;
    border-style: solid;
    content: "";
  }

  .ring::before {
    top: -2px;
    left: -2px;
    border-width: 2px 0 0 2px;
  }

  .ring::after {
    right: -2px;
    bottom: -2px;
    border-width: 0 2px 2px 0;
  }

  .ring-label {
    position: absolute;
    bottom: -28px;
    left: 50%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.6rem;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  :global(body.ar-active) {
    --stage-width: min(100vw, calc(100vh * 1.777778));
    --stage-height: min(100vh, calc(100vw / 1.777778));
    overflow: hidden;
    background: #050505;
  }

  :global(body.ar-active > video) {
    position: fixed !important;
    inset: 0 !important;
    z-index: 1 !important;
    width: var(--stage-width) !important;
    height: var(--stage-height) !important;
    margin: auto !important;
    object-fit: contain !important;
  }

  @media (max-width: 760px) {
    .case-body {
      grid-template-columns: 1fr;
    }

    .case-header,
    .case-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .case-actions > * {
      width: 100%;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.25;
    }
  }
</style>
