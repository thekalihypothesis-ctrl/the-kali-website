---
import ARLayout from '../layouts/ARLayout.astro';
---
<ARLayout title="AR Viewer">
  <a class="exit-ar" href="/">&larr; Exit AR</a>

  <a-scene
    embedded
    arjs="sourceType: webcam; debugUIEnabled: false;"
    vr-mode-ui="enabled: false"
    renderer="logarithmicDepthBuffer: true;"
  >
    <a-marker type="pattern" url="/markers/pattern.patt">
      <a-entity
        id="cover-model"
        gltf-model="/models/cover.glb"
        scale="0.05 0.05 0.05"
        position="0 0 0"
        drag-rotate
      ></a-entity>
    </a-marker>

    <a-entity camera></a-entity>
  </a-scene>

  <script is:inline>
    // Drag-to-rotate component, carried over from the earlier
    // marker-ar project. Attach with drag-rotate="" on any entity.
    AFRAME.registerComponent('drag-rotate', {
      init: function () {
        this.isDragging = false;
        this.previousX = 0;

        const canvas = this.el.sceneEl.canvas;

        canvas.addEventListener('mousedown', (e) => {
          this.isDragging = true;
          this.previousX = e.clientX;
        });
        canvas.addEventListener('touchstart', (e) => {
          this.isDragging = true;
          this.previousX = e.touches[0].clientX;
        });

        window.addEventListener('mouseup', () => (this.isDragging = false));
        window.addEventListener('touchend', () => (this.isDragging = false));

        window.addEventListener('mousemove', (e) => this.handleMove(e.clientX));
        window.addEventListener('touchmove', (e) => {
          if (e.touches.length > 0) this.handleMove(e.touches[0].clientX);
        });
      },
      handleMove: function (currentX) {
        if (!this.isDragging) return;
        const deltaX = currentX - this.previousX;
        const rotation = this.el.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
        this.el.setAttribute('rotation', {
          x: rotation.x,
          y: rotation.y + deltaX * 0.5,
          z: rotation.z,
        });
        this.previousX = currentX;
      },
    });
  </script>
</ARLayout>

<style>
  .exit-ar {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 999;
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.7);
    color: #f5f5f0;
    text-decoration: none;
    font-family: 'Courier New', Courier, monospace;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
  }
</style>
