---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AR Scanner | The Kali Hypothesis">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/aframe/1.4.2/aframe.min.js"></script>
  <script is:inline src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>

  <main class="ar-shell">
    <section id="landing" class="landing" aria-label="AR launch screen">
      <div class="case-folder">
        <header class="case-header">
          <p class="eyebrow">Evidence Terminal</p>
          <p class="case-number">Case 04 / AR</p>
        </header>

        <div class="case-body">
          <section class="case-copy">
            <p class="stamp">The Kali Hypothesis</p>
            <h1>Marker<br /><span>Investigation</span></h1>
            <p class="tagline">
              The archived object is locked to a printed marker. Open the camera and recover the evidence.
            </p>
          </section>

          <aside class="marker-card" aria-label="Marker preview">
            <div class="marker-frame">
              <svg width="132" height="132" viewBox="0 0 132 132" xmlns="http://www.w3.org/2000/svg">
                <rect width="132" height="132" fill="#f8f5ef"></rect>
                <rect x="8" y="8" width="116" height="116" fill="#050505"></rect>
                <rect x="22" y="22" width="88" height="88" fill="#f8f5ef"></rect>
                <rect x="36" y="36" width="60" height="60" fill="#050505"></rect>
                <rect x="49" y="49" width="34" height="34" fill="#f8f5ef"></rect>
                <rect x="59" y="59" width="14" height="14" fill="#050505"></rect>
              </svg>
            </div>
            <p class="marker-hint">Pattern Evidence</p>
          </aside>
        </div>

        <footer class="case-actions">
          <button class="btn-start" id="btn-start" type="button">Open Scanner</button>
          <a class="office-link" href="/">Return to Office</a>
        </footer>
      </div>
    </section>

    <div id="ar-scene-wrapper" class="ar-scene-wrapper">
      <a-scene
        id="main-scene"
        embedded
        arjs="sourceType: webcam; debugUIEnabled: false; detectionMode: mono_and_matrix; matrixCodeType: 3x3;"
        vr-mode-ui="enabled: false"
        renderer="alpha: true; logarithmicDepthBuffer: true; antialias: true; colorManagement: true; physicallyCorrectLights: false; exposure: 1;"
        loading-screen="enabled: false"
      >
        <a-assets>
          <a-asset-item id="cover-model" src="/ar/cover.glb"></a-asset-item>
        </a-assets>

        <a-marker
          id="custom-marker"
          type="pattern"
          url="/ar/pattern.patt"
          smooth="true"
          smoothCount="10"
          smoothTolerance="0.01"
          smoothThreshold="5"
        >
          <a-entity
            id="cover-entity"
            gltf-model="#cover-model"
            position="0 0 0"
            scale="20 20 20"
            rotation="-90 90 0"
            drag-rotate
          ></a-entity>
          <a-light type="ambient" intensity="0.6"></a-light>
          <a-light type="directional" position="1 2 1" intensity="0.8"></a-light>
        </a-marker>

        <a-entity camera></a-entity>
      </a-scene>
    </div>

    <div id="hud" class="hud">
      <div class="hud-row">
        <span class="hud-label">Evidence lock</span>
        <span class="hud-status"><span id="status-dot"></span><span id="status-text">Searching...</span></span>
      </div>
      <p>Drag to inspect the recovered object</p>
    </div>

    <div id="scan-ring" class="scan-ring">
      <div class="ring">
        <span class="ring-label">Seeking marker</span>
      </div>
    </div>

    <button id="btn-close" class="btn-close" type="button" aria-label="Close AR">x</button>
  </main>

  <script is:inline>
    window.addEventListener("load", () => {
      const aframe = window["AFRAME"];
      if (!aframe) return;

      aframe.registerComponent("drag-rotate", {
        init: function () {
          this.dragging = false;
          this.lastX = 0;
          this.lastY = 0;
          this.rotY = 0;
          this.rotX = -90;

          const canvasEl = this.el.sceneEl.canvas;

          const onDown = (event) => {
            this.dragging = true;
            const point = event.touches ? event.touches[0] : event;
            this.lastX = point.clientX;
            this.lastY = point.clientY;
          };

          const onMove = (event) => {
            if (!this.dragging) return;
            const point = event.touches ? event.touches[0] : event;
            const dx = point.clientX - this.lastX;
            const dy = point.clientY - this.lastY;

            this.lastX = point.clientX;
            this.lastY = point.clientY;
            this.rotY += dx * 0.5;
            this.rotX += dy * 0.5;

            this.el.setAttribute("rotation", `${this.rotX} ${this.rotY} 0`);
          };

          const onUp = () => {
            this.dragging = false;
          };

          canvasEl.addEventListener("mousedown", onDown);
          canvasEl.addEventListener("mousemove", onMove);
          canvasEl.addEventListener("mouseup", onUp);
          canvasEl.addEventListener("mouseleave", onUp);
          canvasEl.addEventListener("touchstart", onDown, { passive: true });
          canvasEl.addEventListener("touchmove", onMove, { passive: true });
          canvasEl.addEventListener("touchend", onUp);
        }
      });

      const landing = document.getElementById("landing");
      const sceneWrap = document.getElementById("ar-scene-wrapper");
      const hud = document.getElementById("hud");
      const scanRing = document.getElementById("scan-ring");
      const btnClose = document.getElementById("btn-close");
      const statusText = document.getElementById("status-text");
      const statusDot = document.getElementById("status-dot");
      const btnStart = document.getElementById("btn-start");
      const marker = document.getElementById("custom-marker");

      btnStart?.addEventListener("click", () => {
        document.body.classList.add("ar-active");
        landing.style.display = "none";
        sceneWrap.classList.add("is-active");
        sceneWrap.style.display = "block";
        hud.style.display = "block";
        scanRing.style.display = "block";
        btnClose.style.display = "flex";
      });

      btnClose?.addEventListener("click", () => {
        document.body.classList.remove("ar-active");
        window.location.href = "/";
      });

      marker?.addEventListener("markerFound", () => {
        statusText.textContent = "Evidence recovered";
        statusDot.style.background = "#22c55e";
        scanRing.style.display = "none";
      });

      marker?.addEventListener("markerLost", () => {
        statusText.textContent = "Searching...";
        statusDot.style.background = "#e8431c";
        scanRing.style.display = "block";
      });
    });
  </script>
</BaseLayout>

<style>
  .ar-shell {
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.88)),
      url("/images/detective-office-layout.jpg") center / cover;
    color: #f8f5ef;
  }

  .landing {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(18px, 4vw, 44px);
    background:
      linear-gradient(rgba(5, 5, 5, 0.64), rgba(5, 5, 5, 0.82)),
      url("/images/detective-office-layout.jpg") center / cover;
  }

  .case-folder {
    width: min(980px, 100%);
    max-height: calc(100vh - 36px);
    overflow: auto;
    border: 2px solid #f8f5ef;
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.05), transparent 16%, rgba(5, 5, 5, 0.08)),
      #f8f5ef;
    box-shadow: 12px 12px 0 #050505;
    color: #050505;
  }

  .case-header,
  .case-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(14px, 2.2vw, 22px);
    border-bottom: 2px solid #050505;
  }

  .case-actions {
    border-top: 2px solid #050505;
    border-bottom: 0;
  }

  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    gap: clamp(18px, 4vw, 54px);
    align-items: center;
    padding: clamp(22px, 5vw, 58px);
  }

  .eyebrow {
    margin: 0;
    color: #050505;
    font-size: clamp(0.62rem, 1.4vw, 0.86rem);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .case-number,
  .stamp {
    margin: 0;
    color: #b72d18;
    font-size: clamp(0.62rem, 1.3vw, 0.82rem);
    text-transform: uppercase;
  }

  .stamp {
    display: inline-block;
    margin-bottom: 16px;
    border: 2px solid currentColor;
    padding: 8px 10px 6px;
    transform: rotate(-2deg);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 5.7rem);
    font-weight: 900;
    line-height: 0.88;
    text-transform: uppercase;
  }

  h1 span {
    color: #b72d18;
  }

  .tagline {
    max-width: 28rem;
    margin: 1.4rem 0 0;
    color: #26211e;
    font-size: clamp(0.82rem, 1.6vw, 1.05rem);
    line-height: 1.5;
  }

  .marker-card {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
    padding: 18px;
    border: 2px solid rgba(255, 255, 255, 0.12);
    background:
      repeating-linear-gradient(0deg, rgba(5, 5, 5, 0.08) 0 1px, transparent 1px 12px),
      #050505;
    color: #f8f5ef;
  }

  .marker-frame {
    display: grid;
    width: min(188px, 100%);
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid #f8f5ef;
    background: #f8f5ef;
  }

  .marker-hint {
    margin: 0;
    color: #f8f5ef;
    font-size: 0.68rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .btn-start,
  .office-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 2px solid #050505;
    border-radius: 0;
    background: #050505;
    color: #f8f5ef;
    cursor: pointer;
    font: inherit;
    font-size: clamp(0.72rem, 1.4vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0;
    padding: 0.78rem 1.2rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .office-link {
    color: #050505;
    background: transparent;
  }

  .btn-start:hover,
  .office-link:hover {
    background: #b72d18;
    color: #f8f5ef;
  }

  .ar-scene-wrapper {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: none;
    width: min(100vw, calc(100vh * 1.777778));
    height: min(100vh, calc(100vw / 1.777778));
    margin: auto;
    overflow: hidden;
    background: #050505;
  }

  a-scene {
    width: 100%;
    height: 100%;
  }

  .ar-scene-wrapper video {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  .ar-scene-wrapper canvas.a-canvas {
    width: 100% !important;
    height: 100% !important;
  }

  .hud {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    display: none;
    padding: 1rem 1.4rem 1.5rem;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.86) 0%, rgba(5, 5, 5, 0.18) 100%);
    pointer-events: none;
  }

  .hud-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hud-label,
  .hud-status,
  .hud p {
    font-size: 0.68rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hud-label {
    color: rgba(255, 255, 255, 0.5);
  }

  .hud-status {
    color: #f05a32;
  }

  .hud p {
    margin: 0.6rem 0 0;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
  }

  #status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    animation: pulse 1.6s ease-in-out infinite;
    background: #f05a32;
  }

  .btn-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 60;
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .scan-ring {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 40;
    display: none;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .ring {
    position: relative;
    width: 180px;
    height: 180px;
    border: 2px solid rgba(240, 90, 50, 0.64);
    border-radius: 0;
  }

  .ring::before,
  .ring::after {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: #f05a32;
    border-style: solid;
    content: "";
  }

  .ring::before {
    top: -2px;
    left: -2px;
    border-width: 2px 0 0 2px;
  }

  .ring::after {
    right: -2px;
    bottom: -2px;
    border-width: 0 2px 2px 0;
  }

  .ring-label {
    position: absolute;
    bottom: -28px;
    left: 50%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.6rem;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }


  :global(body.ar-active) {
    overflow: hidden;
    background: #050505;
  }

  :global(body.ar-active .ar-shell) {
    background: transparent;
  }

  :global(body.ar-active .ar-scene-wrapper.is-active) {
    position: fixed !important;
    inset: 0 !important;
    z-index: 10 !important;
    width: min(100vw, calc(100vh * 1.777778)) !important;
    height: min(100vh, calc(100vw / 1.777778)) !important;
    margin: auto !important;
    overflow: hidden !important;
    background: #050505 !important;
  }

  :global(body.ar-active video) {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  :global(body.ar-active canvas.a-canvas),
  :global(body.ar-active .a-canvas) {
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
  }

  :global(body.ar-active a-scene) {
    position: absolute !important;
    inset: 0 !important;
    z-index: 3 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
  }

  :global(body.ar-active .hud) {
    right: 0 !important;
    left: 0 !important;
    width: min(100vw, calc(100vh * 1.777778)) !important;
    margin: 0 auto !important;
  }
  @media (max-width: 760px) {
    .case-body {
      grid-template-columns: 1fr;
    }

    .case-header,
    .case-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .case-actions > * {
      width: 100%;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.25;
    }
  }
</style>



