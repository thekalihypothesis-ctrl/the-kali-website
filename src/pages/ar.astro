---
import ARLayout from '../layouts/ARLayout.astro';
---
<ARLayout title="AR Viewer">
  <a class="exit-ar" href="/">&larr; Exit AR</a>

  <a-scene
    embedded
    arjs="sourceType: webcam; debugUIEnabled: false; sourceWidth: 1280; sourceHeight: 960; displayWidth: 1280; displayHeight: 960;"
    vr-mode-ui="enabled: false"
    renderer="logarithmicDepthBuffer: true; alpha: true;"
  >
    <a-marker type="pattern" url="/markers/pattern.patt">
      <a-entity
        id="cover-model"
        gltf-model="/models/cover.glb"
        scale="0.05 0.05 0.05"
        position="0 0 0"
        drag-rotate
      ></a-entity>
    </a-marker>

    <a-entity camera></a-entity>
  </a-scene>

  <div id="error-popup" hidden></div>

  <script is:inline>
    // #error-popup was styled but never actually shown by anything —
    // AR.js catches its own getUserMedia rejection internally and just
    // logs it, so it never reaches window's error/unhandledrejection
    // handlers. Wrap getUserMedia ourselves, before AR.js calls it, so
    // camera failures are visible instead of a silent black screen.
    (function () {
      var popup = document.getElementById('error-popup');
      function showError(message) {
        popup.textContent = message;
        popup.hidden = false;
      }

      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
        var originalGetUserMedia = navigator.mediaDevices.getUserMedia.bind(navigator.mediaDevices);
        navigator.mediaDevices.getUserMedia = function (constraints) {
          return originalGetUserMedia(constraints).catch(function (err) {
            showError('Camera error: ' + err.name + (err.message ? ' — ' + err.message : ''));
            throw err;
          });
        };
      } else {
        showError('Camera API unavailable — this needs HTTPS (or localhost) and a browser that supports getUserMedia.');
      }

      window.addEventListener('error', function (e) {
        showError('Error: ' + e.message);
      });

      setTimeout(function () {
        if (!document.querySelector('video') && popup.hidden) {
          showError('Camera never attached. Check the permission prompt and reload.');
        }
      }, 8000);
    })();
  </script>

  <script is:inline>
    // Drag-to-rotate component, carried over from the earlier
    // marker-ar project. Attach with drag-rotate="" on any entity.
    AFRAME.registerComponent('drag-rotate', {
      init: function () {
        this.isDragging = false;
        this.previousX = 0;

        const canvas = this.el.sceneEl.canvas;

        canvas.addEventListener('mousedown', (e) => {
          this.isDragging = true;
          this.previousX = e.clientX;
        });
        canvas.addEventListener('touchstart', (e) => {
          this.isDragging = true;
          this.previousX = e.touches[0].clientX;
        });

        window.addEventListener('mouseup', () => (this.isDragging = false));
        window.addEventListener('touchend', () => (this.isDragging = false));

        window.addEventListener('mousemove', (e) => this.handleMove(e.clientX));
        window.addEventListener('touchmove', (e) => {
          if (e.touches.length > 0) this.handleMove(e.touches[0].clientX);
        });
      },
      handleMove: function (currentX) {
        if (!this.isDragging) return;
        const deltaX = currentX - this.previousX;
        const rotation = this.el.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
        this.el.setAttribute('rotation', {
          x: rotation.x,
          y: rotation.y + deltaX * 0.5,
          z: rotation.z,
        });
        this.previousX = currentX;
      },
    });
  </script>
</ARLayout>

<style is:global>
  #error-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1000;
    max-width: 80vw;
    padding: 20px 24px;
    background: rgba(20, 0, 0, 0.9);
    color: #ff6b6b;
    font-family: 'Courier New', Courier, monospace;
    font-size: 16px;
    white-space: pre-wrap;
    border: 1px solid #ff6b6b;
    border-radius: 4px;
  }
</style>

<style>
  .exit-ar {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 999;
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.7);
    color: #f5f5f0;
    text-decoration: none;
    font-family: 'Courier New', Courier, monospace;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
  }
</style>
