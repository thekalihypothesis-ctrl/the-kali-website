---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AR Scanner | The Kali Hypothesis">
  <main class="ar-shell">
    <section id="landing" class="landing" aria-label="AR launch screen">
      <div class="case-folder">
        <header class="case-header">
          <p class="eyebrow">Evidence Terminal</p>
          <p class="case-number">Case 04 / AR</p>
        </header>

        <div class="case-body">
          <section class="case-copy">
            <p class="stamp">The Kali Hypothesis</p>
            <h1>Marker<br /><span>Investigation</span></h1>
            <p class="tagline">
              The archived object is locked to a printed marker. Open the camera and recover the evidence.
            </p>
          </section>

          <aside class="marker-card" aria-label="Marker preview">
            <div class="marker-frame">
              <svg width="132" height="132" viewBox="0 0 132 132" xmlns="http://www.w3.org/2000/svg">
                <rect width="132" height="132" fill="#f8f5ef"></rect>
                <rect x="8" y="8" width="116" height="116" fill="#050505"></rect>
                <rect x="22" y="22" width="88" height="88" fill="#f8f5ef"></rect>
                <rect x="36" y="36" width="60" height="60" fill="#050505"></rect>
                <rect x="49" y="49" width="34" height="34" fill="#f8f5ef"></rect>
                <rect x="59" y="59" width="14" height="14" fill="#050505"></rect>
              </svg>
            </div>
            <p class="marker-hint">Pattern Evidence</p>
          </aside>
        </div>

        <footer class="case-actions">
          <a class="btn-start" href="/scanner">Open Scanner</a>
          <a class="office-link" href="/">Return to Office</a>
        </footer>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .ar-shell {
    --stage-width: min(100vw, calc(100vh * 1.777778));
    --stage-height: min(100vh, calc(100vw / 1.777778));
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(rgba(5, 5, 5, 0.82), rgba(5, 5, 5, 0.88)),
      url("/images/detective-office-layout.jpg") center / contain no-repeat;
    color: #f8f5ef;
  }

  .landing {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(18px, 4vw, 44px);
    background:
      linear-gradient(rgba(5, 5, 5, 0.64), rgba(5, 5, 5, 0.82)),
      url("/images/detective-office-layout.jpg") center / contain no-repeat;
  }

  .case-folder {
    width: min(980px, 100%);
    max-height: calc(100vh - 36px);
    overflow: auto;
    border: 2px solid #f8f5ef;
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.05), transparent 16%, rgba(5, 5, 5, 0.08)),
      #f8f5ef;
    box-shadow: 12px 12px 0 #050505;
    color: #050505;
  }

  .case-header,
  .case-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(14px, 2.2vw, 22px);
    border-bottom: 2px solid #050505;
  }

  .case-actions {
    border-top: 2px solid #050505;
    border-bottom: 0;
  }

  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    gap: clamp(18px, 4vw, 54px);
    align-items: center;
    padding: clamp(22px, 5vw, 58px);
  }

  .eyebrow {
    margin: 0;
    color: #050505;
    font-size: clamp(0.62rem, 1.4vw, 0.86rem);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .case-number,
  .stamp {
    margin: 0;
    color: #b72d18;
    font-size: clamp(0.62rem, 1.3vw, 0.82rem);
    text-transform: uppercase;
  }

  .stamp {
    display: inline-block;
    margin-bottom: 16px;
    border: 2px solid currentColor;
    padding: 8px 10px 6px;
    transform: rotate(-2deg);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 5.7rem);
    font-weight: 900;
    line-height: 0.88;
    text-transform: uppercase;
  }

  h1 span {
    color: #b72d18;
  }

  .tagline {
    max-width: 28rem;
    margin: 1.4rem 0 0;
    color: #26211e;
    font-size: clamp(0.82rem, 1.6vw, 1.05rem);
    line-height: 1.5;
  }

  .marker-card {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
    padding: 18px;
    border: 2px solid rgba(255, 255, 255, 0.12);
    background:
      repeating-linear-gradient(0deg, rgba(5, 5, 5, 0.08) 0 1px, transparent 1px 12px),
      #050505;
    color: #f8f5ef;
  }

  .marker-frame {
    display: grid;
    width: min(188px, 100%);
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid #f8f5ef;
    background: #f8f5ef;
  }

  .marker-hint {
    margin: 0;
    color: #f8f5ef;
    font-size: 0.68rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .btn-start,
  .office-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 2px solid #050505;
    border-radius: 0;
    background: #050505;
    color: #f8f5ef;
    cursor: pointer;
    font: inherit;
    font-size: clamp(0.72rem, 1.4vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0;
    padding: 0.78rem 1.2rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .office-link {
    color: #050505;
    background: transparent;
  }

  .btn-start:hover,
  .office-link:hover {
    background: #b72d18;
    color: #f8f5ef;
  }

  @media (max-width: 760px) {
    .case-body {
      grid-template-columns: 1fr;
    }

    .case-header,
    .case-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .case-actions > * {
      width: 100%;
    }
  }
</style>



