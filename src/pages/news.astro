---
import MainLayout from '../layouts/MainLayout.astro';
import { articles } from '../data/articles.js';

// See src/data/articles.js for the two supported article shapes
// (plain body paragraphs, or a glossary with sections/terms).
---
<MainLayout title="News & Articles">
  <div class="case-file">
    <a class="back-link" href="/">&larr; Back to the office</a>
    <h1>News &amp; Articles</h1>

    {articles.map((article) => (
      <article class="entry">
        <p class="entry-tag">{article.tag}</p>
        <h2>{article.title}</h2>
        {article.dateline && <p class="entry-dateline">{article.dateline}</p>}

        {article.intro?.map((paragraph) => <p>{paragraph}</p>)}
        {article.body?.map((paragraph) => <p>{paragraph}</p>)}

        {article.sections?.map((section) => (
          <div class="glossary-section">
            <h3>{section.heading}</h3>
            <div class="glossary-grid">
              {section.terms.map((entry) => (
                <div class="glossary-term">
                  <p class="term-name">{entry.term}</p>
                  <p class="term-tagline">{entry.tagline}</p>
                  <p class="term-definition">{entry.definition}</p>
                </div>
              ))}
            </div>
            {section.note && <p class="glossary-note">{section.note}</p>}
          </div>
        ))}
      </article>
    ))}
  </div>
</MainLayout>

<style>
  .case-file {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 80px 120px;
    background: #0a0a0a;
    color: #f5f5f0;
    overflow-y: auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: #f5f5f0;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  h1 {
    font-size: 48px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 40px;
  }

  .entry {
    max-width: 1200px;
    padding-top: 32px;
    margin-bottom: 32px;
    border-top: 1px solid rgba(245, 245, 240, 0.3);
  }

  .entry:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .entry-tag {
    margin: 0 0 8px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .entry h2 {
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .entry-dateline {
    margin: -8px 0 16px;
    font-size: 14px;
    opacity: 0.6;
  }

  .entry p {
    max-width: 800px;
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .glossary-section {
    margin-top: 32px;
  }

  .glossary-section h3 {
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(245, 245, 240, 0.3);
  }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px 40px;
  }

  .glossary-term {
    max-width: none;
  }

  .term-name {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    max-width: none;
  }

  .term-tagline {
    margin: 2px 0 6px;
    font-size: 13px;
    font-style: italic;
    opacity: 0.6;
    max-width: none;
  }

  .term-definition {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    max-width: none;
  }

  .glossary-note {
    margin: 24px 0 0;
    font-size: 14px;
    font-style: italic;
    opacity: 0.7;
    max-width: none;
  }
</style>
