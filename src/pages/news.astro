---
import NodeLayout from '../layouts/NodeLayout.astro';
import { articles } from '../data/articles.js';

// See src/data/articles.js for the two supported article shapes
// (plain body paragraphs, or a glossary with sections/terms).
---
<NodeLayout title="News & Articles">
  <div class="feed">
    <a class="back-link" href="/">&larr; Back to the office</a>
    <h1>News &amp; Articles</h1>

    {articles.map((article) => (
      <article class="entry">
        <p class="entry-tag">{article.tag}</p>
        <h2>{article.title}</h2>
        {article.dateline && <p class="entry-dateline">{article.dateline}</p>}

        {article.intro?.map((paragraph) => <p>{paragraph}</p>)}
        {article.body?.map((paragraph) => <p>{paragraph}</p>)}

        {article.sections?.map((section) => (
          <div class="glossary-section">
            <h3>{section.heading}</h3>
            <div class="glossary-grid">
              {section.terms.map((entry) => (
                <div class="glossary-term">
                  <p class="term-name">{entry.term}</p>
                  <p class="term-tagline">{entry.tagline}</p>
                  <p class="term-definition">{entry.definition}</p>
                </div>
              ))}
            </div>
            {section.note && <p class="glossary-note">{section.note}</p>}
          </div>
        ))}
      </article>
    ))}
  </div>
</NodeLayout>

<style>
  .feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: #4dfaff;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(77, 250, 255, 0.4);
  }

  .back-link:hover {
    opacity: 0.7;
  }

  h1 {
    margin: 0 0 48px;
    font-size: 32px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4dfaff;
    text-shadow: 0 0 12px rgba(77, 250, 255, 0.5);
  }

  .entry {
    padding-top: 40px;
    margin-bottom: 40px;
    border-top: 1px dashed rgba(77, 250, 255, 0.25);
  }

  .entry:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .entry-tag {
    margin: 0 0 8px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4dff8f;
    text-shadow: 0 0 6px rgba(77, 255, 143, 0.35);
  }

  .entry h2 {
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 16px;
    max-width: 800px;
    color: #eaeaea;
  }

  .entry-dateline {
    margin: -8px 0 16px;
    font-size: 13px;
    color: #777;
  }

  .entry p {
    max-width: 800px;
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: #ccc;
  }

  .glossary-section {
    margin-top: 32px;
  }

  .glossary-section h3 {
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 16px;
    padding-bottom: 8px;
    color: #4dfaff;
    border-bottom: 1px solid rgba(77, 250, 255, 0.25);
  }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .glossary-term {
    padding: 14px 16px;
    border: 1px dashed rgba(77, 250, 255, 0.3);
    border-radius: 4px;
  }

  .term-name {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #eaeaea;
  }

  .term-tagline {
    margin: 2px 0 8px;
    font-size: 12px;
    font-style: italic;
    color: #4dff8f;
    opacity: 0.8;
  }

  .term-definition {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #bbb;
  }

  .glossary-note {
    margin: 24px 0 0;
    font-size: 13px;
    font-style: italic;
    color: #777;
  }
</style>
