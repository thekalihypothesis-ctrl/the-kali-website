---
import NodeLayout from '../layouts/NodeLayout.astro';
import { articles } from '../data/articles.js';

// The index of finds -- each card links to its own page at
// /news/<slug>, see src/pages/news/[slug].astro and
// src/data/articles.js.
---
<NodeLayout title="News & Articles">
  <div class="feed">
    <a class="back-link" href="/">&larr; Back to the office</a>
    <h1>News &amp; Articles</h1>
    <p class="subhead">Case finds, documented and filed as they turn up.</p>

    <div class="card-grid">
      {articles.map((article) => (
        <a class="card" href={`/news/${article.slug}`}>
          <p class="card-tag">{article.tag}</p>
          <h2>{article.title}</h2>
          {article.dateline && <p class="card-dateline">{article.dateline}</p>}
          <p class="card-teaser">{article.teaser}</p>
          <p class="card-open">Open file &rarr;</p>
        </a>
      ))}
    </div>
  </div>
</NodeLayout>

<style>
  .feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 100px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: #4dfaff;
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(77, 250, 255, 0.4);
  }

  .back-link:hover {
    opacity: 0.7;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 32px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4dfaff;
    text-shadow: 0 0 12px rgba(77, 250, 255, 0.5);
  }

  .subhead {
    margin: 0 0 40px;
    font-size: 15px;
    color: #777;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .card {
    display: block;
    padding: 24px;
    background: rgba(77, 250, 255, 0.03);
    border: 1px dashed rgba(77, 250, 255, 0.3);
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    background: rgba(77, 250, 255, 0.08);
    border-color: rgba(77, 250, 255, 0.7);
  }

  .card-tag {
    margin: 0 0 8px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4dff8f;
  }

  .card h2 {
    margin: 0 0 8px;
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #eaeaea;
  }

  .card-dateline {
    margin: 0 0 12px;
    font-size: 12px;
    color: #666;
  }

  .card-teaser {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.5;
    color: #aaa;
  }

  .card-open {
    margin: 0;
    font-size: 13px;
    color: #4dfaff;
  }
</style>
