---
import NodeLayout from '../layouts/NodeLayout.astro';

// Placeholder fragment art — swap each .fragment-art background-image
// for a real cropped photo once available (see hand-note.png etc. for
// how other art gets dropped into public/images/).
const fragments = [
  { id: 'books', label: 'Books' },
  { id: 'hooded-figure', label: 'Hooded Figure' },
  { id: 'woman', label: 'Woman' },
  { id: 'cat', label: 'Cat' },
  { id: 'mug', label: 'Mug' },
  { id: 'map-key', label: 'Map & Key' },
  { id: 'watch', label: 'Pocket Watch' },
];
---
<NodeLayout title="Node 002: Identity Assembly">
  <main class="node">
    <h1>Node 002: Identity Assembly</h1>
    <p class="instructions">
      Tap a fragment below, then tap a slot to place.<br />
      Tap a filled slot to remove its fragment.
    </p>

    <div class="fragment-tray" data-fragment-tray>
      {fragments.map((fragment) => (
        <button
          class="fragment"
          type="button"
          data-fragment-id={fragment.id}
          aria-label={fragment.label}
        >
          <span class="fragment-art"></span>
          <span class="fragment-label">{fragment.label}</span>
        </button>
      ))}
    </div>

    <div class="slots" data-slots>
      <div class="slot" data-slot-index="0"><span class="slot-hint">Tap Here</span></div>
      <div class="slot" data-slot-index="1"><span class="slot-hint">Tap Here</span></div>
      <div class="slot" data-slot-index="2"><span class="slot-hint">Tap Here</span></div>
    </div>

    <p class="match-readout">PROFILE MATCH: <span data-match-percent>0</span>%</p>
    <p class="status-line" data-status-line hidden></p>

    <div class="actions">
      <button class="action-btn" type="button" data-confirm>Confirm</button>
      <button class="action-btn" type="button" data-reset>Reset</button>
    </div>
  </main>
</NodeLayout>

<script>
  // Placeholder answer key — the 3 fragment ids that count toward a
  // match. Swap these once the real puzzle logic is decided; nothing
  // else here depends on which ids are "correct".
  const CORRECT_FRAGMENT_IDS = ['cat', 'watch', 'map-key'];
  const SLOT_COUNT = 3;

  const tray = document.querySelector('[data-fragment-tray]');
  const slotEls = Array.from(document.querySelectorAll('[data-slots] .slot'));
  const matchPercentEl = document.querySelector('[data-match-percent]');
  const statusLine = document.querySelector('[data-status-line]');

  let selectedFragmentId = null;
  // slotState[i] = fragmentId or null
  const slotState = new Array(SLOT_COUNT).fill(null);

  function fragmentButton(id) {
    return tray.querySelector(`[data-fragment-id="${id}"]`);
  }

  function setSelected(id) {
    if (selectedFragmentId) {
      fragmentButton(selectedFragmentId)?.classList.remove('is-selected');
    }
    selectedFragmentId = id;
    if (id) {
      fragmentButton(id)?.classList.add('is-selected');
    }
  }

  function renderSlot(index) {
    const slotEl = slotEls[index];
    const fragmentId = slotState[index];
    slotEl.innerHTML = '';
    if (!fragmentId) {
      slotEl.classList.remove('is-filled');
      const hint = document.createElement('span');
      hint.className = 'slot-hint';
      hint.textContent = 'Tap Here';
      slotEl.appendChild(hint);
      return;
    }
    slotEl.classList.add('is-filled');
    const label = fragmentButton(fragmentId)?.getAttribute('aria-label') || fragmentId;
    const art = document.createElement('span');
    art.className = 'fragment-art';
    slotEl.appendChild(art);
    const labelEl = document.createElement('span');
    labelEl.className = 'fragment-label';
    labelEl.textContent = label;
    slotEl.appendChild(labelEl);
  }

  function updateMatchPercent() {
    const placed = slotState.filter(Boolean);
    const correctPlaced = placed.filter((id) => CORRECT_FRAGMENT_IDS.includes(id));
    const percent = Math.round((correctPlaced.length / CORRECT_FRAGMENT_IDS.length) * 100);
    matchPercentEl.textContent = String(percent);
  }

  function setStatus(message) {
    if (!message) {
      statusLine.hidden = true;
      statusLine.textContent = '';
      return;
    }
    statusLine.hidden = false;
    statusLine.textContent = message;
  }

  tray.addEventListener('click', (e) => {
    const btn = e.target.closest('.fragment');
    if (!btn || btn.classList.contains('is-used')) return;
    const id = btn.getAttribute('data-fragment-id');
    setSelected(id === selectedFragmentId ? null : id);
  });

  slotEls.forEach((slotEl, index) => {
    slotEl.addEventListener('click', () => {
      const currentFragmentId = slotState[index];

      if (currentFragmentId) {
        // Filled slot tapped -- remove its fragment back to the tray.
        slotState[index] = null;
        fragmentButton(currentFragmentId)?.classList.remove('is-used');
        renderSlot(index);
        updateMatchPercent();
        setStatus('');
        return;
      }

      if (!selectedFragmentId) return; // empty slot, nothing selected: no-op

      slotState[index] = selectedFragmentId;
      fragmentButton(selectedFragmentId)?.classList.add('is-used');
      setSelected(null);
      renderSlot(index);
      updateMatchPercent();
      setStatus('');
    });
  });

  document.querySelector('[data-confirm]')?.addEventListener('click', () => {
    if (slotState.some((id) => !id)) {
      setStatus('INCOMPLETE — fill all 3 slots.');
      return;
    }
    const percent = matchPercentEl.textContent;
    setStatus(
      percent === '100'
        ? 'IDENTITY CONFIRMED.'
        : `MATCH LOGGED AT ${percent}% — not a full match.`,
    );
  });

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    for (let i = 0; i < SLOT_COUNT; i++) {
      slotState[i] = null;
      renderSlot(i);
    }
    document.querySelectorAll('.fragment.is-used').forEach((el) => el.classList.remove('is-used'));
    setSelected(null);
    updateMatchPercent();
    setStatus('');
  });
</script>

<style>
  .node {
    min-height: 100vh;
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0 0 24px;
    font-size: 28px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4dfaff;
    text-shadow: 0 0 12px rgba(77, 250, 255, 0.5);
  }

  .instructions {
    margin: 0 0 40px;
    font-size: 14px;
    line-height: 1.6;
    color: #999;
  }

  .fragment-tray {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .fragment {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100px;
    padding: 0;
    background: none;
    border: none;
    color: #ccc;
    font-family: inherit;
    cursor: pointer;
  }

  .fragment-art {
    display: block;
    width: 100px;
    height: 100px;
    background: repeating-linear-gradient(45deg, #161618, #161618 10px, #1e1e21 10px, #1e1e21 20px);
    border: 1px solid #333;
    border-radius: 2px;
  }

  .fragment.is-selected .fragment-art {
    border-color: #4dfaff;
    box-shadow: 0 0 10px rgba(77, 250, 255, 0.6);
  }

  .fragment.is-used {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .fragment-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #888;
  }

  .slots {
    display: flex;
    gap: 20px;
    margin-bottom: 32px;
  }

  .slot {
    width: 110px;
    height: 130px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px dashed #444;
    border-radius: 4px;
    cursor: pointer;
  }

  .slot.is-filled {
    border-style: solid;
    border-color: #4dfaff;
  }

  .slot .fragment-art {
    width: 80px;
    height: 80px;
  }

  .slot-hint {
    font-size: 12px;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .match-readout {
    margin: 0 0 8px;
    font-size: 16px;
    letter-spacing: 0.04em;
    color: #4dff8f;
    text-shadow: 0 0 8px rgba(77, 255, 143, 0.4);
  }

  .status-line {
    margin: 0 0 24px;
    font-size: 13px;
    color: #eee;
  }

  .actions {
    display: flex;
    gap: 16px;
  }

  .action-btn {
    padding: 10px 28px;
    background: transparent;
    color: #4dfaff;
    border: 1px solid #4dfaff;
    border-radius: 4px;
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .action-btn:hover {
    background: rgba(77, 250, 255, 0.1);
  }
</style>
